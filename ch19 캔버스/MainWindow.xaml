<Window x:Class="ch19_캔버스.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch19_캔버스"
        mc:Ignorable="d"
        Title="ch19 캔버스 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <!-- 코드 보기 스타일 -->
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="420"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <TabControl>
        <!-- 탭 1: 기본 사용법 -->
        <TabItem Header="기본 사용법">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="Canvas 기본 사용법" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Canvas는 자식 요소를 절대 좌표로 배치하는 패널입니다. 연결 속성(Attached Property)인 Canvas.Left, Canvas.Top, Canvas.Right, Canvas.Bottom을 사용하여 위치를 지정합니다."
                               TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- 예제 1: 기본 Canvas -->
                    <GroupBox Header="기본 Canvas" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="150" Background="#F5F5F5">
                                <Rectangle Fill="SteelBlue" Width="80" Height="60" Canvas.Left="20" Canvas.Top="20"/>
                                <Ellipse Fill="Coral" Width="70" Height="70" Canvas.Left="120" Canvas.Top="40"/>
                                <TextBlock Text="텍스트" Canvas.Left="220" Canvas.Top="60" FontSize="16"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;150&quot; Background=&quot;#F5F5F5&quot;&gt;&#10;    &lt;Rectangle Fill=&quot;SteelBlue&quot; Width=&quot;80&quot; Height=&quot;60&quot;&#10;               Canvas.Left=&quot;20&quot; Canvas.Top=&quot;20&quot;/&gt;&#10;    &lt;Ellipse Fill=&quot;Coral&quot; Width=&quot;70&quot; Height=&quot;70&quot;&#10;             Canvas.Left=&quot;120&quot; Canvas.Top=&quot;40&quot;/&gt;&#10;    &lt;TextBlock Text=&quot;텍스트&quot; Canvas.Left=&quot;220&quot; Canvas.Top=&quot;60&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <!-- 직접 해보기 1_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Canvas에 Rectangle을 배치하세요. Canvas.Left=&quot;50&quot;, Canvas.Top=&quot;30&quot; 위치에 Width=&quot;100&quot;, Height=&quot;60&quot;, Fill=&quot;Orange&quot;인 사각형을 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;120&quot; Background=&quot;#EEEEEE&quot;&gt;&#10;    &lt;!-- 여기에 Rectangle 추가 --&gt;&#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_1"
                                       Text="힌트: Rectangle 태그에 Canvas.Left, Canvas.Top 연결 속성을 사용하세요."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: 컨트롤 배치 -->
                    <GroupBox Header="다양한 컨트롤 배치" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="120" Background="#E8F5E9">
                                <Button Content="버튼 1" Canvas.Left="30" Canvas.Top="30"/>
                                <Button Content="버튼 2" Canvas.Left="130" Canvas.Top="50"/>
                                <CheckBox Content="체크박스" Canvas.Left="250" Canvas.Top="40"/>
                                <TextBox Text="텍스트박스" Width="100" Canvas.Left="380" Canvas.Top="35"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;120&quot; Background=&quot;#E8F5E9&quot;&gt;&#10;    &lt;Button Content=&quot;버튼 1&quot; Canvas.Left=&quot;30&quot; Canvas.Top=&quot;30&quot;/&gt;&#10;    &lt;Button Content=&quot;버튼 2&quot; Canvas.Left=&quot;130&quot; Canvas.Top=&quot;50&quot;/&gt;&#10;    &lt;CheckBox Content=&quot;체크박스&quot; Canvas.Left=&quot;250&quot; Canvas.Top=&quot;40&quot;/&gt;&#10;    &lt;TextBox Text=&quot;텍스트박스&quot; Width=&quot;100&quot;&#10;             Canvas.Left=&quot;380&quot; Canvas.Top=&quot;35&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <!-- 직접 해보기 1_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Canvas에 Ellipse와 TextBlock을 배치하세요. Ellipse(Width=80, Height=80, Fill=LightBlue)를 (100, 20)에, TextBlock(&quot;원 위에 텍스트&quot;)를 (110, 50)에 배치하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;120&quot; Background=&quot;#FFF8E1&quot;&gt;&#10;    &lt;!-- Ellipse와 TextBlock 추가 --&gt;&#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_2"
                                       Text="힌트: 두 요소 모두 Canvas.Left와 Canvas.Top 속성을 지정하세요."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: Canvas 크기 동작 -->
                    <GroupBox Header="Canvas의 크기 특성" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Canvas는 자식 요소의 크기를 고려하지 않습니다. 자식이 Canvas 경계를 벗어나도 클리핑되지 않습니다 (ClipToBounds=False가 기본값)."
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border BorderBrush="Gray" BorderThickness="1" Height="100" Width="300">
                                <Canvas Background="#FFF3E0" ClipToBounds="False">
                                    <Rectangle Fill="Orange" Width="100" Height="80" Canvas.Left="230" Canvas.Top="30"/>
                                </Canvas>
                            </Border>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;!-- ClipToBounds=&quot;False&quot;가 기본값 --&gt;&#10;&lt;Border BorderBrush=&quot;Gray&quot; BorderThickness=&quot;1&quot; Height=&quot;100&quot; Width=&quot;300&quot;&gt;&#10;    &lt;Canvas Background=&quot;#FFF3E0&quot; ClipToBounds=&quot;False&quot;&gt;&#10;        &lt;Rectangle Fill=&quot;Orange&quot; Width=&quot;100&quot; Height=&quot;80&quot;&#10;                   Canvas.Left=&quot;230&quot; Canvas.Top=&quot;30&quot;/&gt;&#10;    &lt;/Canvas&gt;&#10;&lt;/Border&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                
                <!-- 직접 해보기 1_3 -->
                <Expander Style="{StaticResource PracticeExpanderStyle}">
                    <StackPanel Margin="10">
                        <TextBlock Text="과제: Canvas 에 사각형 하나를 왼쪽 20, 위 20 위치에 놓으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="txtPractice1_3"
                                 Style="{StaticResource PracticeInputStyle}"
                                 Text="&lt;Canvas Height=&quot;140&quot; Background=&quot;#FAFAFA&quot;&gt;&#10;    &#10;&lt;/Canvas&gt;"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                            <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                            <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                        </StackPanel>
                        <TextBlock x:Name="txtHint1_3"
                                   Text="힌트: Canvas.Left 와 Canvas.Top 첨부 속성을 씁니다."
                                   Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                            <StackPanel x:Name="resultPanel1_3"/>
                        </Border>
                    </StackPanel>
                </Expander>
</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭 2: 위치 지정 -->
        <TabItem Header="위치 지정">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="위치 지정 속성" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Canvas는 4개의 연결 속성으로 위치를 지정합니다: Canvas.Left(왼쪽에서), Canvas.Top(위에서), Canvas.Right(오른쪽에서), Canvas.Bottom(아래에서)."
                               TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- 예제 1: Left와 Top -->
                    <GroupBox Header="Canvas.Left와 Canvas.Top" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="130" Background="#E3F2FD">
                                <Button Content="Left=10, Top=10" Canvas.Left="10" Canvas.Top="10"/>
                                <Button Content="Left=150, Top=50" Canvas.Left="150" Canvas.Top="50"/>
                                <Button Content="Left=300, Top=80" Canvas.Left="300" Canvas.Top="80"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;130&quot; Background=&quot;#E3F2FD&quot;&gt;&#10;    &lt;Button Content=&quot;Left=10, Top=10&quot;&#10;            Canvas.Left=&quot;10&quot; Canvas.Top=&quot;10&quot;/&gt;&#10;    &lt;Button Content=&quot;Left=150, Top=50&quot;&#10;            Canvas.Left=&quot;150&quot; Canvas.Top=&quot;50&quot;/&gt;&#10;    &lt;Button Content=&quot;Left=300, Top=80&quot;&#10;            Canvas.Left=&quot;300&quot; Canvas.Top=&quot;80&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 2_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Canvas.Right와 Canvas.Bottom을 사용하여 Rectangle을 우하단에 배치하세요. Canvas.Right=&quot;20&quot;, Canvas.Bottom=&quot;20&quot;, Width=&quot;80&quot;, Height=&quot;50&quot;, Fill=&quot;Purple&quot;" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;120&quot; Background=&quot;#E8EAF6&quot;&gt;&#10;    &lt;!-- Right, Bottom 속성 사용 --&gt;&#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_1"
                                       Text="힌트: Canvas.Right와 Canvas.Bottom은 각각 오른쪽, 아래쪽 가장자리로부터의 거리입니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: Right와 Bottom -->
                    <GroupBox Header="Canvas.Right와 Canvas.Bottom" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="130" Background="#FCE4EC">
                                <Button Content="Right=10, Bottom=10" Canvas.Right="10" Canvas.Bottom="10"/>
                                <Button Content="Right=200, Bottom=50" Canvas.Right="200" Canvas.Bottom="50"/>
                                <Button Content="Right=400, Top=10" Canvas.Right="400" Canvas.Top="10"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;130&quot; Background=&quot;#FCE4EC&quot;&gt;&#10;    &lt;Button Content=&quot;Right=10, Bottom=10&quot;&#10;            Canvas.Right=&quot;10&quot; Canvas.Bottom=&quot;10&quot;/&gt;&#10;    &lt;Button Content=&quot;Right=200, Bottom=50&quot;&#10;            Canvas.Right=&quot;200&quot; Canvas.Bottom=&quot;50&quot;/&gt;&#10;    &lt;Button Content=&quot;Right=400, Top=10&quot;&#10;            Canvas.Right=&quot;400&quot; Canvas.Top=&quot;10&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 2_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 4개의 Ellipse를 각 모서리에 배치하세요. 각각 Width=40, Height=40으로 설정하고, 각 모서리에서 10픽셀 떨어진 곳에 배치하세요. Fill 색상은 Red, Blue, Green, Yellow를 사용하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;120&quot; Background=&quot;#ECEFF1&quot;&gt;&#10;    &lt;!-- 좌상단: Red --&gt;&#10;    &lt;!-- 우상단: Blue --&gt;&#10;    &lt;!-- 좌하단: Green --&gt;&#10;    &lt;!-- 우하단: Yellow --&gt;&#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_2"
                                       Text="힌트: 좌상단은 Left+Top, 우상단은 Right+Top, 좌하단은 Left+Bottom, 우하단은 Right+Bottom 조합을 사용하세요."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: 모서리 배치 -->
                    <GroupBox Header="4개 모서리에 배치" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="150" Background="#F3E5F5">
                                <Rectangle Fill="Purple" Width="60" Height="40" Canvas.Left="5" Canvas.Top="5"/>
                                <Rectangle Fill="Indigo" Width="60" Height="40" Canvas.Right="5" Canvas.Top="5"/>
                                <Rectangle Fill="DarkMagenta" Width="60" Height="40" Canvas.Left="5" Canvas.Bottom="5"/>
                                <Rectangle Fill="Violet" Width="60" Height="40" Canvas.Right="5" Canvas.Bottom="5"/>
                                <TextBlock Text="중앙" Canvas.Left="370" Canvas.Top="65" FontSize="14"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;150&quot; Background=&quot;#F3E5F5&quot;&gt;&#10;    &lt;!-- 좌상단 --&gt;&#10;    &lt;Rectangle Fill=&quot;Purple&quot; Width=&quot;60&quot; Height=&quot;40&quot;&#10;               Canvas.Left=&quot;5&quot; Canvas.Top=&quot;5&quot;/&gt;&#10;    &lt;!-- 우상단 --&gt;&#10;    &lt;Rectangle Fill=&quot;Indigo&quot; Width=&quot;60&quot; Height=&quot;40&quot;&#10;               Canvas.Right=&quot;5&quot; Canvas.Top=&quot;5&quot;/&gt;&#10;    &lt;!-- 좌하단 --&gt;&#10;    &lt;Rectangle Fill=&quot;DarkMagenta&quot; Width=&quot;60&quot; Height=&quot;40&quot;&#10;               Canvas.Left=&quot;5&quot; Canvas.Bottom=&quot;5&quot;/&gt;&#10;    &lt;!-- 우하단 --&gt;&#10;    &lt;Rectangle Fill=&quot;Violet&quot; Width=&quot;60&quot; Height=&quot;40&quot;&#10;               Canvas.Right=&quot;5&quot; Canvas.Bottom=&quot;5&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 2_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Canvas 오른쪽 아래 구석에 원을 붙이세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;140&quot; Background=&quot;#FAFAFA&quot;&gt;&#10;    &#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_3"
                                       Text="힌트: Canvas.Right 와 Canvas.Bottom 을 쓰면 반대쪽 기준으로 배치됩니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 4: 위치 미지정 시 -->
                    <GroupBox Header="위치 미지정 시 동작" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="위치를 지정하지 않으면 (0, 0) 좌표에 배치됩니다." Margin="0,0,0,10"/>
