                            <TextBox x:Name="txtPractice2_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;100&quot; Background=&quot;#FFFDE7&quot;&gt;&#10;    &#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_4"
                                       Text="힌트: 위치를 지정하지 않으면 (0,0)에 붙습니다. Canvas.Left / Canvas.Top 을 씁니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                
</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭 3: ZIndex와 겹침 -->
        <TabItem Header="ZIndex와 겹침">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="ZIndex와 겹침 순서" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Canvas에서 요소가 겹칠 때 Panel.ZIndex 속성으로 표시 순서를 제어합니다. ZIndex 값이 클수록 위에 표시됩니다. 기본값은 0입니다."
                               TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- 예제 1: 기본 겹침 순서 -->
                    <GroupBox Header="기본 겹침 순서 (XAML 순서)" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ZIndex를 지정하지 않으면 XAML에서 나중에 선언된 요소가 위에 표시됩니다." Margin="0,0,0,10"/>
                            <Canvas Height="150" Background="#ECEFF1">
                                <Rectangle Fill="Red" Width="100" Height="100" Canvas.Left="50" Canvas.Top="25"/>
                                <Rectangle Fill="Green" Width="100" Height="100" Canvas.Left="100" Canvas.Top="35"/>
                                <Rectangle Fill="Blue" Width="100" Height="100" Canvas.Left="150" Canvas.Top="45"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;!-- ZIndex 미지정: 나중 요소가 위에 --&gt;&#10;&lt;Canvas Height=&quot;150&quot; Background=&quot;#ECEFF1&quot;&gt;&#10;    &lt;Rectangle Fill=&quot;Red&quot; Width=&quot;100&quot; Height=&quot;100&quot;&#10;               Canvas.Left=&quot;50&quot; Canvas.Top=&quot;25&quot;/&gt;&#10;    &lt;Rectangle Fill=&quot;Green&quot; Width=&quot;100&quot; Height=&quot;100&quot;&#10;               Canvas.Left=&quot;100&quot; Canvas.Top=&quot;35&quot;/&gt;&#10;    &lt;Rectangle Fill=&quot;Blue&quot; Width=&quot;100&quot; Height=&quot;100&quot;&#10;               Canvas.Left=&quot;150&quot; Canvas.Top=&quot;45&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 3_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 3개의 겹치는 Ellipse를 만들고, Panel.ZIndex를 사용하여 Yellow가 맨 위, Red가 중간, Blue가 맨 아래에 오도록 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;130&quot; Background=&quot;#FAFAFA&quot;&gt;&#10;    &lt;Ellipse Fill=&quot;Blue&quot; Width=&quot;80&quot; Height=&quot;80&quot; Canvas.Left=&quot;50&quot; Canvas.Top=&quot;25&quot;/&gt;&#10;    &lt;Ellipse Fill=&quot;Red&quot; Width=&quot;80&quot; Height=&quot;80&quot; Canvas.Left=&quot;90&quot; Canvas.Top=&quot;35&quot;/&gt;&#10;    &lt;Ellipse Fill=&quot;Yellow&quot; Width=&quot;80&quot; Height=&quot;80&quot; Canvas.Left=&quot;130&quot; Canvas.Top=&quot;25&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_1"
                                       Text="힌트: Panel.ZIndex 값이 클수록 위에 표시됩니다. Yellow에 가장 큰 값을, Blue에 가장 작은 값을 주세요."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder3_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel3_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: ZIndex 사용 -->
                    <GroupBox Header="Panel.ZIndex로 순서 변경" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="빨간색에 가장 높은 ZIndex를 주어 맨 위로 올렸습니다." Margin="0,0,0,10"/>
                            <Canvas Height="150" Background="#ECEFF1">
                                <Rectangle Fill="Red" Width="100" Height="100" Canvas.Left="50" Canvas.Top="25" Panel.ZIndex="3"/>
                                <Rectangle Fill="Green" Width="100" Height="100" Canvas.Left="100" Canvas.Top="35" Panel.ZIndex="1"/>
                                <Rectangle Fill="Blue" Width="100" Height="100" Canvas.Left="150" Canvas.Top="45" Panel.ZIndex="2"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;150&quot; Background=&quot;#ECEFF1&quot;&gt;&#10;    &lt;Rectangle Fill=&quot;Red&quot; Width=&quot;100&quot; Height=&quot;100&quot;&#10;               Canvas.Left=&quot;50&quot; Canvas.Top=&quot;25&quot;&#10;               Panel.ZIndex=&quot;3&quot;/&gt;  &lt;!-- 맨 위 --&gt;&#10;    &lt;Rectangle Fill=&quot;Green&quot; Width=&quot;100&quot; Height=&quot;100&quot;&#10;               Canvas.Left=&quot;100&quot; Canvas.Top=&quot;35&quot;&#10;               Panel.ZIndex=&quot;1&quot;/&gt;  &lt;!-- 맨 아래 --&gt;&#10;    &lt;Rectangle Fill=&quot;Blue&quot; Width=&quot;100&quot; Height=&quot;100&quot;&#10;               Canvas.Left=&quot;150&quot; Canvas.Top=&quot;45&quot;&#10;               Panel.ZIndex=&quot;2&quot;/&gt;  &lt;!-- 중간 --&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 3_2 (코드 비교 방식) -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Panel.SetZIndex 메서드를 사용하여 element를 맨 위로 올리는 코드를 작성하세요. ZIndex 값은 10으로 설정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="// element를 맨 위로 올리기&#x0a;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="3_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_2"
                                       Text="힌트: Panel.SetZIndex(요소, 값) 형식으로 사용합니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult3_2"
                                       Margin="0,8,0,0" FontWeight="Bold" Visibility="Collapsed"/>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: 음수 ZIndex -->
                    <GroupBox Header="음수 ZIndex" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ZIndex는 음수도 가능합니다. 값이 작을수록 뒤로 갑니다." Margin="0,0,0,10"/>
                            <Canvas Height="130" Background="#E8EAF6">
                                <Ellipse Fill="Salmon" Width="200" Height="100" Canvas.Left="100" Canvas.Top="15" Panel.ZIndex="-1"/>
                                <TextBlock Text="텍스트가 원 위에" Canvas.Left="150" Canvas.Top="50" FontSize="16" FontWeight="Bold"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;130&quot; Background=&quot;#E8EAF6&quot;&gt;&#10;    &lt;Ellipse Fill=&quot;Salmon&quot; Width=&quot;200&quot; Height=&quot;100&quot;&#10;             Canvas.Left=&quot;100&quot; Canvas.Top=&quot;15&quot;&#10;             Panel.ZIndex=&quot;-1&quot;/&gt;  &lt;!-- 배경으로 --&gt;&#10;    &lt;TextBlock Text=&quot;텍스트가 원 위에&quot;&#10;               Canvas.Left=&quot;150&quot; Canvas.Top=&quot;50&quot;&#10;               FontSize=&quot;16&quot; FontWeight=&quot;Bold&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 3_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 사각형 3개를 겹쳐 놓고 ZIndex 로 초록색이 맨 위에 오게 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;140&quot; Background=&quot;#FAFAFA&quot;&gt;&#10;    &#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_3"
                                       Text="힌트: Panel.ZIndex 값이 클수록 위에 그려집니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder3_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel3_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 4: 코드로 ZIndex 변경 -->
                    <GroupBox Header="코드로 ZIndex 변경" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="130" Background="#FFF8E1">
                                <Rectangle x:Name="rectA" Fill="Tomato" Width="80" Height="80" Canvas.Left="150" Canvas.Top="25"/>
                                <Rectangle x:Name="rectB" Fill="MediumSeaGreen" Width="80" Height="80" Canvas.Left="190" Canvas.Top="35"/>
                            </Canvas>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="빨강을 위로" Click="BringRedToFront_Click" Margin="0,0,10,0" Padding="10,5"/>
                                <Button Content="초록을 위로" Click="BringGreenToFront_Click" Padding="10,5"/>
                            </StackPanel>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;!-- XAML --&gt;&#10;&lt;Rectangle x:Name=&quot;rectA&quot; Fill=&quot;Tomato&quot; .../&gt;&#10;&lt;Rectangle x:Name=&quot;rectB&quot; Fill=&quot;MediumSeaGreen&quot; .../&gt;&#10;&lt;Button Content=&quot;빨강을 위로&quot; Click=&quot;BringRedToFront_Click&quot;/&gt;&#10;&#10;// C# 코드비하인드&#10;private void BringRedToFront_Click(object sender, RoutedEventArgs e)&#10;{&#10;    Panel.SetZIndex(rectA, 1);&#10;    Panel.SetZIndex(rectB, 0);&#10;}&#10;private void BringGreenToFront_Click(object sender, RoutedEventArgs e)&#10;{&#10;    Panel.SetZIndex(rectA, 0);&#10;    Panel.SetZIndex(rectB, 1);&#10;}"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 3_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 빨간 사각형(rectA)을 초록 사각형(rectB) 위로 올리는 핸들러를 완성하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     AcceptsReturn="True"
                                     Text="private void BringRedToFront_Click(object sender, RoutedEventArgs e)&#10;{&#10;    &#10;}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="3_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_4"
                                       Text="힌트: 겹침 순서는 Panel.SetZIndex(요소, 숫자) 로 바꿉니다. 숫자가 클수록 위입니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult3_4" Margin="0,8,0,0" FontWeight="Bold"
                                       Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                
</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭 4: 도형 그리기 -->
        <TabItem Header="도형 그리기">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="Canvas에서 도형 그리기" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Canvas는 그래픽 작업에 최적화된 패널입니다. Rectangle, Ellipse, Line, Polyline, Polygon 등 다양한 도형을 그릴 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- 예제 1: Rectangle과 Ellipse -->
                    <GroupBox Header="Rectangle과 Ellipse" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="130" Background="#E0F7FA">
                                <Rectangle Fill="DodgerBlue" Stroke="Navy" StrokeThickness="2"
                                           Width="100" Height="70" Canvas.Left="30" Canvas.Top="30"/>
                                <Ellipse Fill="LightCoral" Stroke="DarkRed" StrokeThickness="2"
                                         Width="100" Height="70" Canvas.Left="160" Canvas.Top="30"/>
                                <Rectangle Fill="Transparent" Stroke="Green" StrokeThickness="3"
                                           Width="80" Height="80" Canvas.Left="290" Canvas.Top="25"
                                           RadiusX="15" RadiusY="15"/>
                                <Ellipse Fill="Gold" Width="60" Height="60" Canvas.Left="400" Canvas.Top="35"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;130&quot; Background=&quot;#E0F7FA&quot;&gt;&#10;    &lt;Rectangle Fill=&quot;DodgerBlue&quot; Stroke=&quot;Navy&quot; StrokeThickness=&quot;2&quot;&#10;               Width=&quot;100&quot; Height=&quot;70&quot; Canvas.Left=&quot;30&quot; Canvas.Top=&quot;30&quot;/&gt;&#10;    &lt;Ellipse Fill=&quot;LightCoral&quot; Stroke=&quot;DarkRed&quot; StrokeThickness=&quot;2&quot;&#10;             Width=&quot;100&quot; Height=&quot;70&quot; Canvas.Left=&quot;160&quot; Canvas.Top=&quot;30&quot;/&gt;&#10;    &lt;!-- 둥근 모서리 사각형 --&gt;&#10;    &lt;Rectangle Fill=&quot;Transparent&quot; Stroke=&quot;Green&quot; StrokeThickness=&quot;3&quot;&#10;               Width=&quot;80&quot; Height=&quot;80&quot; RadiusX=&quot;15&quot; RadiusY=&quot;15&quot;/&gt;&#10;    &lt;Ellipse Fill=&quot;Gold&quot; Width=&quot;60&quot; Height=&quot;60&quot;/&gt;  &lt;!-- 원 --&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <!-- 직접 해보기 4_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 둥근 모서리 사각형을 만드세요. Fill=&quot;LightGreen&quot;, Stroke=&quot;DarkGreen&quot;, StrokeThickness=&quot;2&quot;, Width=&quot;100&quot;, Height=&quot;60&quot;, RadiusX=&quot;10&quot;, RadiusY=&quot;10&quot;, 위치는 (50, 30)" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Canvas Height=&quot;120&quot; Background=&quot;#F5F5F5&quot;&gt;&#10;    &lt;!-- 둥근 모서리 Rectangle --&gt;&#10;&lt;/Canvas&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_1"
                                       Text="힌트: Rectangle의 RadiusX, RadiusY 속성으로 모서리 둥글기를 설정합니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: Line -->
                    <GroupBox Header="Line (선)" Margin="0,0,0,15">
                        <StackPanel>
                            <Canvas Height="120" Background="#FFF3E0">
                                <Line X1="20" Y1="20" X2="200" Y2="20" Stroke="Black" StrokeThickness="2"/>
                                <Line X1="20" Y1="50" X2="200" Y2="100" Stroke="Blue" StrokeThickness="3"/>
                                <Line X1="250" Y1="20" X2="250" Y2="100" Stroke="Red" StrokeThickness="4"/>
                                <Line X1="300" Y1="60" X2="500" Y2="60" Stroke="Green" StrokeThickness="2"
                                      StrokeDashArray="5,3"/>
                            </Canvas>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;Canvas Height=&quot;120&quot; Background=&quot;#FFF3E0&quot;&gt;&#10;    &lt;!-- 수평선 --&gt;&#10;    &lt;Line X1=&quot;20&quot; Y1=&quot;20&quot; X2=&quot;200&quot; Y2=&quot;20&quot;&#10;          Stroke=&quot;Black&quot; StrokeThickness=&quot;2&quot;/&gt;&#10;    &lt;!-- 대각선 --&gt;&#10;    &lt;Line X1=&quot;20&quot; Y1=&quot;50&quot; X2=&quot;200&quot; Y2=&quot;100&quot;&#10;          Stroke=&quot;Blue&quot; StrokeThickness=&quot;3&quot;/&gt;&#10;    &lt;!-- 수직선 --&gt;&#10;    &lt;Line X1=&quot;250&quot; Y1=&quot;20&quot; X2=&quot;250&quot; Y2=&quot;100&quot;&#10;          Stroke=&quot;Red&quot; StrokeThickness=&quot;4&quot;/&gt;&#10;    &lt;!-- 점선 --&gt;&#10;    &lt;Line X1=&quot;300&quot; Y1=&quot;60&quot; X2=&quot;500&quot; Y2=&quot;60&quot;&#10;          Stroke=&quot;Green&quot; StrokeThickness=&quot;2&quot;&#10;          StrokeDashArray=&quot;5,3&quot;/&gt;&#10;&lt;/Canvas&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <!-- 직접 해보기 4_2 -->
