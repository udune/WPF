                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;UniformGrid Columns=&quot;4&quot;&gt;&#10;    &lt;UniformGrid.Resources&gt;&#10;        &lt;Style TargetType=&quot;Button&quot;&gt;&#10;            &lt;Setter Property=&quot;Margin&quot; Value=&quot;4&quot;/&gt;&#10;            &lt;Setter Property=&quot;FontSize&quot; Value=&quot;14&quot;/&gt;&#10;            &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot;/&gt;&#10;            &lt;Setter Property=&quot;Background&quot; Value=&quot;#BBDEFB&quot;/&gt;&#10;        &lt;/Style&gt;&#10;    &lt;/UniformGrid.Resources&gt;&#10;    &lt;Button Content=&quot;A&quot;/&gt;&#10;    &lt;Button Content=&quot;B&quot;/&gt;&#10;    ...&#10;&lt;/UniformGrid&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 4_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 3열 UniformGrid에 각각 다른 Margin(10, 5, 2)을 가진 Border 3개를 배치하세요. 각 Border에는 Background를 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid Columns=&quot;3&quot;&gt;&#10;    &lt;Border Background=&quot;LightBlue&quot; Margin=&quot;10&quot;/&gt;&#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_2"
                                       Text="힌트: 각 Border에 Margin=&quot;10&quot;, Margin=&quot;5&quot;, Margin=&quot;2&quot;를 각각 지정하세요."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 게임 보드 스타일 -->
                    <GroupBox Header="게임 보드 (체스판 스타일)" Margin="0,0,0,8">
                        <UniformGrid x:Name="ugChessBoard" Columns="8" Rows="8" Width="240" Height="240" HorizontalAlignment="Left"/>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- 체스판은 코드비하인드에서 생성 --&gt;&#10;for (int r = 0; r &lt; 8; r++)&#10;{&#10;    for (int c = 0; c &lt; 8; c++)&#10;    {&#10;        var border = new Border();&#10;        border.Background = (r + c) % 2 == 0&#10;            ? Brushes.White&#10;            : new SolidColorBrush(Color.FromRgb(0x76, 0x9a, 0x56));&#10;        ugChessBoard.Children.Add(border);&#10;    }&#10;}"/>
                    </Expander>
                    <!-- 직접 해보기 4_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: UniformGrid 의 첫 칸을 비우고 시작하도록 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid Rows=&quot;2&quot; Columns=&quot;3&quot; Height=&quot;100&quot;&gt;&#10;    &lt;Button Content=&quot;A&quot; Margin=&quot;3&quot;/&gt;&#10;    &lt;Button Content=&quot;B&quot; Margin=&quot;3&quot;/&gt;&#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_3"
                                       Text="힌트: FirstColumn 속성으로 시작 칸을 밀 수 있습니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- Margin/Padding -->
                    <GroupBox Header="Margin과 Padding" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="UniformGrid 자체에는 셀 간격 속성이 없으므로 자식의 Margin으로 조절" Margin="8" TextWrapping="Wrap"/>
                            <UniformGrid Columns="3" Height="80" Background="#F5F5F5" Margin="8">
                                <Border Background="#FFCC80" Margin="8"><TextBlock Text="M=8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#FFB74D" Margin="4"><TextBlock Text="M=4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#FFA726" Margin="2"><TextBlock Text="M=2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;UniformGrid Columns=&quot;3&quot;&gt;&#10;    &lt;Border Margin=&quot;8&quot;&gt;...&lt;/Border&gt;&#10;    &lt;Border Margin=&quot;4&quot;&gt;...&lt;/Border&gt;&#10;    &lt;Border Margin=&quot;2&quot;&gt;...&lt;/Border&gt;&#10;&lt;/UniformGrid&gt;&#10;&#10;&lt;!-- 자식 요소의 Margin으로 간격 조절 --&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 4_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 3열 UniformGrid 안에 Border 3개를 넣고, Margin으로 칸 사이를 8만큼 띄우세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid Columns=&quot;3&quot;&gt;&#10;    &#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_4"
                                       Text="힌트: UniformGrid 에는 간격 속성이 없습니다. 자식 Border 에 Margin 을 줍니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                
</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭5: 코드비하인드 -->
        <TabItem Header="코드비하인드">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>

                    <TextBlock Text="코드비하인드로 UniformGrid 제어" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- 동적으로 자식 추가 -->
                    <GroupBox Header="동적으로 자식 추가/삭제" Margin="0,0,0,8">
                        <StackPanel>
                            <UniformGrid x:Name="ugDynamic" Columns="4" Height="120" Background="#F5F5F5" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="버튼 추가" Click="AddButton_Click" Padding="12,6" Margin="4"/>
                                <Button Content="마지막 삭제" Click="RemoveButton_Click" Padding="12,6" Margin="4"/>
                                <Button Content="전체 삭제" Click="ClearButtons_Click" Padding="12,6" Margin="4"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="// 자식 추가&#10;var btn = new Button { Content = &quot;버튼&quot; + count };&#10;ugDynamic.Children.Add(btn);&#10;&#10;// 마지막 자식 삭제&#10;if (ugDynamic.Children.Count &gt; 0)&#10;    ugDynamic.Children.RemoveAt(ugDynamic.Children.Count - 1);&#10;&#10;// 전체 삭제&#10;ugDynamic.Children.Clear();"/>
                    </Expander>

                    <!-- 직접 해보기 5_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: UniformGrid에 버튼을 동적으로 추가하는 코드를 작성하세요. 버튼 내용은 &quot;Item&quot; + 번호로 설정합니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="private void AddItem_Click(object sender, RoutedEventArgs e)&#x0a;{&#x0a;    // 코드 작성&#x0a;}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="5_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_1"
                                       Text="힌트: new Button { Content = ... }로 버튼을 생성하고 ugGrid.Children.Add()로 추가합니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult5_1"
                                       Margin="0,8,0,0" FontWeight="Bold" Visibility="Collapsed"/>
                        </StackPanel>
                    </Expander>

                    <!-- Rows/Columns 동적 변경 -->
                    <GroupBox Header="Rows/Columns 동적 변경" Margin="0,0,0,8">
                        <StackPanel>
                            <UniformGrid x:Name="ugResize" Height="150" Background="#F5F5F5" Margin="0,0,0,8">
                                <Border Background="#BBDEFB" Margin="2"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                                <Border Background="#90CAF9" Margin="2"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                                <Border Background="#64B5F6" Margin="2"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                                <Border Background="#42A5F5" Margin="2"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/></Border>
                                <Border Background="#2196F3" Margin="2"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/></Border>
                                <Border Background="#1E88E5" Margin="2"><TextBlock Text="6" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/></Border>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="2열" Click="SetCol2_Click" Padding="12,6" Margin="4"/>
                                <Button Content="3열" Click="SetCol3_Click" Padding="12,6" Margin="4"/>
                                <Button Content="6열" Click="SetCol6_Click" Padding="12,6" Margin="4"/>
                                <Button Content="2행×3열" Click="Set2x3_Click" Padding="12,6" Margin="4"/>
                                <Button Content="자동" Click="SetAuto_Click" Padding="12,6" Margin="4"/>
                            </StackPanel>
                            <TextBlock x:Name="tbGridInfo" Text="현재: 자동" Margin="8,4"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="// Columns 변경&#10;ugResize.Columns = 3;&#10;&#10;// Rows 변경&#10;ugResize.Rows = 2;&#10;&#10;// 자동 계산으로 되돌리기 (0으로 설정)&#10;ugResize.Columns = 0;&#10;ugResize.Rows = 0;&#10;&#10;// FirstColumn 변경&#10;ugResize.FirstColumn = 2;"/>
                    </Expander>

                    <!-- 직접 해보기 5_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: UniformGrid를 4행 2열로 변경하는 코드를 작성하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="private void SetLayout_Click(object sender, RoutedEventArgs e)&#x0a;{&#x0a;    // 코드 작성&#x0a;}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="5_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_2"
                                       Text="힌트: ugGrid.Rows = 4; ugGrid.Columns = 2; 처럼 속성을 직접 설정합니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult5_2"
                                       Margin="0,8,0,0" FontWeight="Bold" Visibility="Collapsed"/>
                        </StackPanel>
                    </Expander>

                    <!-- FirstColumn 동적 변경 -->
                    <GroupBox Header="FirstColumn 동적 변경" Margin="0,0,0,8">
                        <StackPanel>
                            <UniformGrid x:Name="ugFirstCol" Columns="5" Height="80" Background="#F5F5F5" Margin="0,0,0,8">
                                <Border Background="#C8E6C9" Margin="2"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#A5D6A7" Margin="2"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#81C784" Margin="2"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#66BB6A" Margin="2"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#4CAF50" Margin="2"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="FirstColumn=0" Click="SetFirstCol0_Click" Padding="12,6" Margin="4"/>
                                <Button Content="FirstColumn=1" Click="SetFirstCol1_Click" Padding="12,6" Margin="4"/>
                                <Button Content="FirstColumn=2" Click="SetFirstCol2_Click" Padding="12,6" Margin="4"/>
                                <Button Content="FirstColumn=3" Click="SetFirstCol3_Click" Padding="12,6" Margin="4"/>
                            </StackPanel>
                            <TextBlock x:Name="tbFirstColInfo" Text="현재 FirstColumn: 0" Margin="8,4"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="// FirstColumn 속성 변경&#10;ugFirstCol.FirstColumn = 0;  // 기본값&#10;ugFirstCol.FirstColumn = 1;  // 첫 번째 셀 비움&#10;ugFirstCol.FirstColumn = 2;  // 첫 두 셀 비움&#10;&#10;// 캘린더 구현 시 월 시작 요일 조정에 활용&#10;// 예: 1일이 수요일이면 FirstColumn = 3"/>
                    </Expander>

                    <!-- 직접 해보기 5_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: FirstColumn을 3으로 설정하여 첫 3개의 셀을 비우는 코드를 작성하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="private void SetOffset_Click(object sender, RoutedEventArgs e)&#x0a;{&#x0a;    // 코드 작성&#x0a;}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="5_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_3"
                                       Text="힌트: ugGrid.FirstColumn = 3; 으로 시작 열을 지정합니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult5_3"
                                       Margin="0,8,0,0" FontWeight="Bold" Visibility="Collapsed"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
