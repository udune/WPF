<Window x:Class="ch18_유니폼그리드.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ch18 UniformGrid 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="420"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <TabControl>

        <!-- 탭1: 기본 사용법 -->
        <TabItem Header="기본 사용법">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>

                    <TextBlock Text="UniformGrid 기본 사용법" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="UniformGrid는 모든 셀이 동일한 크기를 가지는 특수한 Grid입니다. 행/열 정의가 필요 없으며, 자식 요소를 순서대로 자동 배치합니다." TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- 기본 UniformGrid -->
                    <GroupBox Header="Rows와 Columns 지정" Margin="0,0,0,8">
                        <UniformGrid Rows="2" Columns="3" Height="120" Background="#F5F5F5">
                            <Button Content="1" Margin="2"/>
                            <Button Content="2" Margin="2"/>
                            <Button Content="3" Margin="2"/>
                            <Button Content="4" Margin="2"/>
                            <Button Content="5" Margin="2"/>
                            <Button Content="6" Margin="2"/>
                        </UniformGrid>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;UniformGrid Rows=&quot;2&quot; Columns=&quot;3&quot;&gt;&#10;    &lt;Button Content=&quot;1&quot;/&gt;&#10;    &lt;Button Content=&quot;2&quot;/&gt;&#10;    &lt;Button Content=&quot;3&quot;/&gt;&#10;    &lt;Button Content=&quot;4&quot;/&gt;&#10;    &lt;Button Content=&quot;5&quot;/&gt;&#10;    &lt;Button Content=&quot;6&quot;/&gt;&#10;&lt;/UniformGrid&gt;&#10;&#10;&lt;!-- 모든 셀이 동일한 크기로 균등 분할됩니다 --&gt;&#10;&lt;!-- 자식 요소는 왼쪽→오른쪽, 위→아래 순서로 배치 --&gt;"/>
                    </Expander>

                    <!-- 직접 해보기 1_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 3행 2열의 UniformGrid를 만들고 버튼 6개를 배치하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid &gt;&#10;    &lt;Button Content=&quot;A&quot;/&gt;&#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_1"
                                       Text="힌트: Rows=&quot;3&quot; Columns=&quot;2&quot; 속성을 사용하세요."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- Grid와 비교 -->
                    <GroupBox Header="Grid vs UniformGrid 비교" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Grid: 각 행/열의 크기를 개별 설정 가능" Margin="8,8,8,4"/>
                            <Grid Height="80" Background="#E3F2FD" Margin="8,0,8,8" ShowGridLines="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="1*" Grid.Column="0" Margin="2"/>
                                <Button Content="2*" Grid.Column="1" Margin="2"/>
                                <Button Content="1*" Grid.Column="2" Margin="2"/>
                            </Grid>
                            <TextBlock Text="UniformGrid: 모든 셀이 동일한 크기" Margin="8,8,8,4"/>
                            <UniformGrid Columns="3" Height="80" Background="#E8F5E9" Margin="8,0,8,8">
                                <Button Content="균등" Margin="2"/>
                                <Button Content="균등" Margin="2"/>
                                <Button Content="균등" Margin="2"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- Grid: 열마다 다른 크기 --&gt;&#10;&lt;Grid&gt;&#10;    &lt;Grid.ColumnDefinitions&gt;&#10;        &lt;ColumnDefinition Width=&quot;1*&quot;/&gt;&#10;        &lt;ColumnDefinition Width=&quot;2*&quot;/&gt;&#10;        &lt;ColumnDefinition Width=&quot;1*&quot;/&gt;&#10;    &lt;/Grid.ColumnDefinitions&gt;&#10;    &lt;Button Grid.Column=&quot;0&quot;/&gt;&#10;    &lt;Button Grid.Column=&quot;1&quot;/&gt;&#10;    &lt;Button Grid.Column=&quot;2&quot;/&gt;&#10;&lt;/Grid&gt;&#10;&#10;&lt;!-- UniformGrid: 모든 셀이 동일 크기 --&gt;&#10;&lt;UniformGrid Columns=&quot;3&quot;&gt;&#10;    &lt;Button/&gt;&#10;    &lt;Button/&gt;&#10;    &lt;Button/&gt;&#10;&lt;/UniformGrid&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 2행 4열의 UniformGrid에 Border 8개를 배치하고, 각 Border에 서로 다른 배경색을 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid Rows=&quot;2&quot; Columns=&quot;4&quot;&gt;&#10;    &lt;Border Background=&quot;Red&quot; Margin=&quot;2&quot;/&gt;&#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_2"
                                       Text="힌트: Border를 8개 추가하고 각각 다른 Background 색상을 지정하세요."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 순차 배치 -->
                    <GroupBox Header="순차 배치 (왼쪽→오른쪽, 위→아래)" Margin="0,0,0,8">
                        <UniformGrid Rows="3" Columns="3" Height="150" Background="#F5F5F5">
                            <Border Background="#BBDEFB" Margin="2"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#90CAF9" Margin="2"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#64B5F6" Margin="2"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#C8E6C9" Margin="2"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#A5D6A7" Margin="2"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#81C784" Margin="2"><TextBlock Text="6" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#FFE0B2" Margin="2"><TextBlock Text="7" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#FFCC80" Margin="2"><TextBlock Text="8" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                            <Border Background="#FFB74D" Margin="2"><TextBlock Text="9" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                        </UniformGrid>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;UniformGrid Rows=&quot;3&quot; Columns=&quot;3&quot;&gt;&#10;    &lt;!-- 배치 순서: --&gt;&#10;    &lt;!-- (0,0) (0,1) (0,2) --&gt;&#10;    &lt;!-- (1,0) (1,1) (1,2) --&gt;&#10;    &lt;!-- (2,0) (2,1) (2,2) --&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;1&quot;/&gt;&lt;/Border&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;2&quot;/&gt;&lt;/Border&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;3&quot;/&gt;&lt;/Border&gt;&#10;    ...&#10;&lt;/UniformGrid&gt;&#10;&#10;&lt;!-- Grid.Row, Grid.Column 속성은 사용 불가 --&gt;&#10;&lt;!-- 자동으로 순서대로 배치됩니다 --&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: UniformGrid 에 버튼 4개를 넣어 2x2 로 배치하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid Rows=&quot;2&quot; Columns=&quot;2&quot; Height=&quot;120&quot;&gt;&#10;    &#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_3"
                                       Text="힌트: UniformGrid 는 자식을 순서대로 같은 크기 칸에 채웁니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                
</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭2: 자동 계산 -->
        <TabItem Header="행/열 자동 계산">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>

                    <TextBlock Text="행/열 자동 계산" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Rows 또는 Columns 중 하나만 지정하거나 둘 다 생략하면 자동으로 계산됩니다." TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Columns만 지정 -->
                    <GroupBox Header="Columns만 지정 (행 자동 계산)" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Columns=4, 자식 10개 → 3행 자동 생성" Margin="8"/>
                            <UniformGrid Columns="4" Height="120" Background="#F5F5F5">
                                <Button Content="1" Margin="2"/>
                                <Button Content="2" Margin="2"/>
                                <Button Content="3" Margin="2"/>
                                <Button Content="4" Margin="2"/>
                                <Button Content="5" Margin="2"/>
                                <Button Content="6" Margin="2"/>
                                <Button Content="7" Margin="2"/>
                                <Button Content="8" Margin="2"/>
                                <Button Content="9" Margin="2"/>
                                <Button Content="10" Margin="2"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;UniformGrid Columns=&quot;4&quot;&gt;&#10;    &lt;!-- 자식 10개 / 4열 = 3행 (올림) --&gt;&#10;    &lt;Button Content=&quot;1&quot;/&gt;&#10;    &lt;Button Content=&quot;2&quot;/&gt;&#10;    ...&#10;    &lt;Button Content=&quot;10&quot;/&gt;&#10;&lt;/UniformGrid&gt;&#10;&#10;&lt;!-- 마지막 행의 빈 셀은 비어있습니다 --&gt;"/>
                    </Expander>

                    <!-- 직접 해보기 2_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Columns만 3으로 지정하고 버튼 7개를 배치하세요. (행은 자동 계산)" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid&gt;&#10;    &lt;Button Content=&quot;1&quot;/&gt;&#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_1"
                                       Text="힌트: Columns=&quot;3&quot;만 지정하면 7개 버튼에 대해 3행이 자동으로 생성됩니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- Rows만 지정 -->
                    <GroupBox Header="Rows만 지정 (열 자동 계산)" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Rows=2, 자식 7개 → 4열 자동 생성" Margin="8"/>
                            <UniformGrid Rows="2" Height="100" Background="#F5F5F5">
                                <Button Content="1" Margin="2"/>
                                <Button Content="2" Margin="2"/>
                                <Button Content="3" Margin="2"/>
                                <Button Content="4" Margin="2"/>
                                <Button Content="5" Margin="2"/>
                                <Button Content="6" Margin="2"/>
                                <Button Content="7" Margin="2"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;UniformGrid Rows=&quot;2&quot;&gt;&#10;    &lt;!-- 자식 7개 / 2행 = 4열 (올림) --&gt;&#10;    &lt;Button Content=&quot;1&quot;/&gt;&#10;    &lt;Button Content=&quot;2&quot;/&gt;&#10;    ...&#10;    &lt;Button Content=&quot;7&quot;/&gt;&#10;&lt;/UniformGrid&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 5열짜리 UniformGrid에 FirstColumn=2를 설정하여 첫 두 셀을 비우고 버튼 6개를 배치하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid Columns=&quot;5&quot;&gt;&#10;    &lt;Button Content=&quot;1&quot;/&gt;&#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_2"
                                       Text="힌트: FirstColumn=&quot;2&quot; 속성을 추가하면 첫 행의 앞 두 셀이 비워집니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 둘 다 생략 -->
                    <GroupBox Header="둘 다 생략 (완전 자동)" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="자식 6개 → 정사각형에 가까운 구조 (3×2 또는 2×3)" Margin="8"/>
                            <UniformGrid Height="100" Background="#F5F5F5">
                                <Border Background="#E1BEE7" Margin="2"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#CE93D8" Margin="2"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <Border Background="#BA68C8" Margin="2"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
                                <Border Background="#AB47BC" Margin="2"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
                                <Border Background="#9C27B0" Margin="2"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
                                <Border Background="#8E24AA" Margin="2"><TextBlock Text="6" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;UniformGrid&gt;&#10;    &lt;!-- Rows, Columns 모두 생략 --&gt;&#10;    &lt;!-- 자식 개수에 따라 자동 계산 --&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;1&quot;/&gt;&lt;/Border&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;2&quot;/&gt;&lt;/Border&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;3&quot;/&gt;&lt;/Border&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;4&quot;/&gt;&lt;/Border&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;5&quot;/&gt;&lt;/Border&gt;&#10;    &lt;Border&gt;&lt;TextBlock Text=&quot;6&quot;/&gt;&lt;/Border&gt;&#10;&lt;/UniformGrid&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Columns 만 3으로 지정하고 자식 5개를 넣어 행이 자동으로 늘어나는지 보세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;UniformGrid Columns=&quot;3&quot; Height=&quot;120&quot;&gt;&#10;    &#10;&lt;/UniformGrid&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_3"
