<Window x:Class="ch23_메뉴.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch23_메뉴"
        mc:Ignorable="d"
        Title="ch23 Menu 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="420"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl>
            <!-- 탭 1: 기본 사용법 -->
            <TabItem Header="기본 사용법">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Menu 기본 사용법" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- 기본 Menu -->
                        <GroupBox Header="기본 Menu와 MenuItem" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Menu는 MenuItem들을 포함하는 메뉴 바입니다:" Margin="0,0,0,5"/>
                                <Menu>
                                    <MenuItem Header="파일"/>
                                    <MenuItem Header="편집"/>
                                    <MenuItem Header="보기"/>
                                    <MenuItem Header="도움말"/>
                                </Menu>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Menu&gt;&#10;    &lt;MenuItem Header=&quot;파일&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;편집&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;보기&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;도움말&quot;/&gt;&#10;&lt;/Menu&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Menu 를 만들고 &quot;파일&quot;, &quot;편집&quot; 두 개의 최상위 MenuItem 을 넣으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Menu&gt;&#10;    &#10;&lt;/Menu&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_1"
                                           Text="힌트: Menu 안에 &lt;MenuItem Header=&quot;...&quot;/&gt; 를 나열합니다. Content 가 아니라 Header 입니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- DockPanel과 함께 사용 -->
                        <GroupBox Header="DockPanel과 함께 사용" Margin="0,0,0,10">
                            <DockPanel Height="120" Background="White" LastChildFill="True">
                                <Menu DockPanel.Dock="Top" Background="#F0F0F0">
                                    <MenuItem Header="File"/>
                                    <MenuItem Header="Edit"/>
                                    <MenuItem Header="View"/>
                                </Menu>
                                <TextBlock Text="메뉴 아래 콘텐츠 영역" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DockPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;DockPanel LastChildFill=&quot;True&quot;&gt;&#10;    &lt;Menu DockPanel.Dock=&quot;Top&quot; Background=&quot;#F0F0F0&quot;&gt;&#10;        &lt;MenuItem Header=&quot;File&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;Edit&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;View&quot;/&gt;&#10;    &lt;/Menu&gt;&#10;    &lt;TextBlock Text=&quot;메뉴 아래 콘텐츠 영역&quot;/&gt;&#10;&lt;/DockPanel&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: &quot;파일&quot; 메뉴 아래에 &quot;새로 만들기&quot;, &quot;열기&quot;, &quot;종료&quot; 하위 항목을 넣으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Menu&gt;&#10;    &lt;MenuItem Header=&quot;파일&quot;&gt;&#10;        &#10;    &lt;/MenuItem&gt;&#10;&lt;/Menu&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_2"
                                           Text="힌트: MenuItem 을 여는 태그로 바꾸고 그 안에 자식 MenuItem 을 넣습니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 접근 키 (Access Key) -->
                        <GroupBox Header="접근 키 (Access Key) - Alt+문자" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Header에 _를 붙이면 접근 키가 됩니다 (Alt 누르면 밑줄 표시):" Margin="0,0,0,5"/>
                                <Menu>
                                    <MenuItem Header="_File"/>
                                    <MenuItem Header="_Edit"/>
                                    <MenuItem Header="_View"/>
                                    <MenuItem Header="_Help"/>
                                </Menu>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Menu&gt;&#10;    &lt;MenuItem Header=&quot;_File&quot;/&gt;   &lt;!-- Alt+F --&gt;&#10;    &lt;MenuItem Header=&quot;_Edit&quot;/&gt;   &lt;!-- Alt+E --&gt;&#10;    &lt;MenuItem Header=&quot;_View&quot;/&gt;   &lt;!-- Alt+V --&gt;&#10;    &lt;MenuItem Header=&quot;_Help&quot;/&gt;   &lt;!-- Alt+H --&gt;&#10;&lt;/Menu&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Menu 에 &quot;보기&quot; 항목을 추가하고 그 아래 &quot;확대&quot;, &quot;축소&quot;를 넣으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Menu&gt;&#10;    &#10;&lt;/Menu&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_3"
                                           Text="힌트: 최상위 MenuItem 안에 자식 MenuItem 을 중첩합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_3"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                        
                        <!-- 클릭 이벤트 -->
                        <GroupBox Header="클릭 이벤트 처리" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="MenuItem의 Click 이벤트로 동작을 처리합니다:" Margin="0,0,0,5"/>
                                <Menu>
                                    <MenuItem Header="동작">
                                        <MenuItem Header="메시지 표시" Click="ShowMessage_Click"/>
                                        <MenuItem Header="시간 표시" Click="ShowTime_Click"/>
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;MenuItem Header=&quot;메시지 표시&quot; Click=&quot;ShowMessage_Click&quot;/&gt;&#10;&#10;// C# 코드&#10;private void ShowMessage_Click(object sender, RoutedEventArgs e)&#10;{&#10;    MessageBox.Show(&quot;메뉴가 클릭되었습니다!&quot;, &quot;알림&quot;);&#10;}"/>
                        </Expander>
                        <!-- 직접 해보기 1_4 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: '메시지 표시' 메뉴를 누르면 알림 상자를 띄우는 핸들러를 완성하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_4"
                                         Style="{StaticResource PracticeInputStyle}"
                                         AcceptsReturn="True"
                                         Text="private void ShowMessage_Click(object sender, RoutedEventArgs e)&#10;{&#10;    &#10;}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="1_4"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_4"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_4"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_4"
                                           Text="힌트: MessageBox.Show(&quot;본문&quot;, &quot;제목&quot;) 형태로 호출합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtResult1_4" Margin="0,8,0,0" FontWeight="Bold"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                    

</StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 2: 계층 구조 -->
            <TabItem Header="계층 구조">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Menu 계층 구조" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- 서브메뉴 -->
                        <GroupBox Header="서브메뉴 (중첩 MenuItem)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="MenuItem 안에 MenuItem을 중첩하여 서브메뉴를 만듭니다:" Margin="0,0,0,5"/>
                                <Menu>
                                    <MenuItem Header="파일">
                                        <MenuItem Header="새로 만들기"/>
                                        <MenuItem Header="열기"/>
                                        <MenuItem Header="저장"/>
                                        <MenuItem Header="다른 이름으로 저장"/>
                                        <MenuItem Header="종료"/>
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;MenuItem Header=&quot;파일&quot;&gt;&#10;    &lt;MenuItem Header=&quot;새로 만들기&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;열기&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;저장&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;다른 이름으로 저장&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;종료&quot;/&gt;&#10;&lt;/MenuItem&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 2_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: &quot;편집&quot; 메뉴 안에 &quot;찾기&quot; 항목을 만들고, 그 아래 다시 &quot;현재 문서&quot;, &quot;전체 문서&quot;를 넣어 3단 구조를 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Menu&gt;&#10;    &lt;MenuItem Header=&quot;편집&quot;&gt;&#10;        &#10;    &lt;/MenuItem&gt;&#10;&lt;/Menu&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_1"
                                           Text="힌트: MenuItem 은 몇 단계든 중첩할 수 있습니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 다단계 서브메뉴 -->
                        <GroupBox Header="다단계 서브메뉴" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="여러 단계로 중첩된 서브메뉴:" Margin="0,0,0,5"/>
                                <Menu>
                                    <MenuItem Header="새로 만들기">
                                        <MenuItem Header="프로젝트">
                                            <MenuItem Header="WPF 앱"/>
                                            <MenuItem Header="콘솔 앱"/>
                                            <MenuItem Header="클래스 라이브러리"/>
                                        </MenuItem>
                                        <MenuItem Header="파일">
                                            <MenuItem Header="클래스"/>
                                            <MenuItem Header="인터페이스"/>
                                            <MenuItem Header="XAML 페이지"/>
                                        </MenuItem>
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;MenuItem Header=&quot;새로 만들기&quot;&gt;&#10;    &lt;MenuItem Header=&quot;프로젝트&quot;&gt;&#10;        &lt;MenuItem Header=&quot;WPF 앱&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;콘솔 앱&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;클래스 라이브러리&quot;/&gt;&#10;    &lt;/MenuItem&gt;&#10;    &lt;MenuItem Header=&quot;파일&quot;&gt;&#10;        &lt;MenuItem Header=&quot;클래스&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;인터페이스&quot;/&gt;&#10;    &lt;/MenuItem&gt;&#10;&lt;/MenuItem&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 2_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: &quot;파일&quot; 메뉴에서 &quot;저장&quot;과 &quot;종료&quot; 사이를 Separator 로 구분하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Menu&gt;&#10;    &lt;MenuItem Header=&quot;파일&quot;&gt;&#10;        &lt;MenuItem Header=&quot;저장&quot;/&gt;&#10;        &#10;        &lt;MenuItem Header=&quot;종료&quot;/&gt;&#10;    &lt;/MenuItem&gt;&#10;&lt;/Menu&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_2"
                                           Text="힌트: 메뉴 항목 사이에 &lt;Separator/&gt; 를 넣으면 구분선이 생깁니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Separator -->
                        <GroupBox Header="Separator (구분선)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Separator로 메뉴 항목을 그룹화합니다:" Margin="0,0,0,5"/>
                                <Menu>
                                    <MenuItem Header="편집">
                                        <MenuItem Header="실행 취소"/>
                                        <MenuItem Header="다시 실행"/>
                                        <Separator/>
                                        <MenuItem Header="잘라내기"/>
                                        <MenuItem Header="복사"/>
                                        <MenuItem Header="붙여넣기"/>
                                        <Separator/>
                                        <MenuItem Header="모두 선택"/>
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;MenuItem Header=&quot;편집&quot;&gt;&#10;    &lt;MenuItem Header=&quot;실행 취소&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;다시 실행&quot;/&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;MenuItem Header=&quot;잘라내기&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;복사&quot;/&gt;&#10;    &lt;MenuItem Header=&quot;붙여넣기&quot;/&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;MenuItem Header=&quot;모두 선택&quot;/&gt;&#10;&lt;/MenuItem&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 2_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: &quot;삽입&quot; 메뉴 아래 &quot;표&quot; 항목을 만들고 그 아래 다시 &quot;행 추가&quot;, &quot;열 추가&quot;를 넣으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Menu&gt;&#10;    &lt;MenuItem Header=&quot;삽입&quot;&gt;&#10;        &#10;    &lt;/MenuItem&gt;&#10;&lt;/Menu&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_3"
                                           Text="힌트: 3단 중첩입니다. MenuItem 안에 MenuItem 안에 MenuItem."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
