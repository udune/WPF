                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint4_1"
                                           Text="힌트: StringFormat='현재 값: {0:F0} 점' 처럼 씁니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder4_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel4_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Self 바인딩 -->
                        <GroupBox Header="RelativeSource Self (자기 자신)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="자기 자신의 다른 속성을 바인딩합니다:" Margin="0,0,0,5"/>
                                <TextBox x:Name="selfBindingBox" Text="자기 자신의 너비:" Padding="5"
                                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                <TextBlock Text="※ TextBox 위에 마우스를 올리면 ToolTip에 Text가 표시됩니다"
                                           FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>

                                <Border Margin="0,15,0,0" BorderBrush="Gray" BorderThickness="1" Padding="10"
                                        Height="80"
                                        Width="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight}">
                                    <TextBlock Text="정사각형 Border (Width=Height)"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- ToolTip에 자신의 Text 바인딩 --&gt;&#10;&lt;TextBox Text=&quot;텍스트&quot; ToolTip=&quot;{Binding RelativeSource={RelativeSource Self}, Path=Text}&quot;/&gt;&#10;&#10;&lt;!-- 정사각형 만들기 (Width = Height) --&gt;&#10;&lt;Border Width=&quot;{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight}&quot;&gt;&#10;    &lt;TextBlock Text=&quot;정사각형&quot;/&gt;&#10;&lt;/Border&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 4_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: TextBox 가 비어 있을 때 TextBlock 에 &quot;(입력 없음)&quot; 이 뜨도록 TargetNullValue 대신 FallbackValue 를 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice4_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;TextBox x:Name=&quot;s5&quot; Width=&quot;200&quot;/&gt;&#10;    &lt;TextBlock Text=&quot;{Binding ElementName=없는이름, Path=Text}&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint4_2"
                                           Text="힌트: 바인딩이 실패할 때 쓰이는 값이 FallbackValue 입니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder4_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel4_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- TemplatedParent -->
                        <GroupBox Header="StringFormat (문자열 포맷)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="바인딩 값에 포맷을 적용합니다:" Margin="0,0,0,5"/>
                                <Slider x:Name="formatSlider" Minimum="0" Maximum="100" Value="50"/>
                                <TextBlock Text="{Binding ElementName=formatSlider, Path=Value, StringFormat=값: {0:F1}}"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ElementName=formatSlider, Path=Value, StringFormat=퍼센트: {0:F0}%}"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ElementName=formatSlider, Path=Value, StringFormat=통화: {0:C0}}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Slider x:Name=&quot;formatSlider&quot; Value=&quot;50&quot;/&gt;&#10;&#10;&lt;!-- 소수점 1자리 --&gt;&#10;&lt;TextBlock Text=&quot;{Binding ElementName=formatSlider, Path=Value, StringFormat=값: {0:F1}}&quot;/&gt;&#10;&#10;&lt;!-- 퍼센트 --&gt;&#10;&lt;TextBlock Text=&quot;{Binding ElementName=formatSlider, Path=Value, StringFormat={}{0:F0}%}&quot;/&gt;&#10;&#10;&lt;!-- 통화 --&gt;&#10;&lt;TextBlock Text=&quot;{Binding ElementName=formatSlider, Path=Value, StringFormat={}{0:C0}}&quot;/&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 4_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Slider 값을 소수점 둘째 자리까지 보여 주도록 StringFormat 을 쓰세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice4_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;Slider x:Name=&quot;s7&quot; Minimum=&quot;0&quot; Maximum=&quot;10&quot; Width=&quot;220&quot;/&gt;&#10;    &lt;TextBlock/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint4_3"
                                           Text="힌트: 형식 문자열이 중괄호로 시작하면 XAML 이 마크업 확장으로 오해하므로 앞에 {} 를 붙여 {}{0:F2} 로 씁니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder4_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel4_3"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                        
                        <!-- FallbackValue, TargetNullValue -->
                        <GroupBox Header="FallbackValue / TargetNullValue" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="바인딩 실패 시 또는 null 값일 때 대체 값을 지정합니다:" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding NonExistentProperty, FallbackValue=바인딩 실패 시 표시되는 값}"
                                           Background="LightCoral" Padding="5"/>
                                <TextBlock Text="※ FallbackValue: 바인딩이 실패하면 표시되는 값"
                                           FontStyle="Italic" Foreground="Gray" Margin="0,5,0,10"/>

                                <TextBox x:Name="nullableTextBox" Padding="5"/>
                                <TextBlock Text="※ TargetNullValue: 값이 null이면 표시되는 값"
                                           FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- 바인딩 실패 시 대체값 --&gt;&#10;&lt;TextBlock Text=&quot;{Binding NonExistent, FallbackValue=기본값}&quot;/&gt;&#10;&#10;&lt;!-- null일 때 대체값 --&gt;&#10;&lt;TextBlock Text=&quot;{Binding NullableProperty, TargetNullValue=값 없음}&quot;/&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 4_4 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 바인딩이 실패했을 때 '기본값'이 대신 보이도록 FallbackValue를 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice4_4"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;TextBlock Text=&quot;{Binding NonExistent}&quot;/&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_4"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_4"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_4"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint4_4"
                                           Text="힌트: Binding 안에 FallbackValue=기본값 을 덧붙입니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder4_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel4_4"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                    

</StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 5: 실용 예제 -->
            <TabItem Header="실용 예제">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="실용 예제" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- 로그인 폼 -->
                        <GroupBox Header="로그인 폼 미리보기" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="입력 폼:" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="사용자명:"/>
                                    <TextBox x:Name="usernameInput" Padding="5" Margin="0,2,0,10"/>
                                    <TextBlock Text="이메일:"/>
                                    <TextBox x:Name="emailInput" Padding="5" Margin="0,2,0,10"/>
                                    <CheckBox x:Name="agreeCheck" Content="이용약관 동의"/>
                                    <Button Content="가입하기" Padding="10,5" Margin="0,10,0,0"
                                            IsEnabled="{Binding ElementName=agreeCheck, Path=IsChecked}"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="LightGray" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="미리보기:" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock Text="사용자명:"/>
                                        <TextBlock Text="{Binding ElementName=usernameInput, Path=Text}"
                                                   FontWeight="Bold" Margin="0,2,0,10"/>
                                        <TextBlock Text="이메일:"/>
                                        <TextBlock Text="{Binding ElementName=emailInput, Path=Text}"
                                                   FontWeight="Bold" Margin="0,2,0,10"/>
                                        <TextBlock Text="{Binding ElementName=agreeCheck, Path=IsChecked,
                                                   StringFormat=동의 여부: {0}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- 입력과 미리보기 동기화 --&gt;&#10;&lt;TextBox x:Name=&quot;usernameInput&quot;/&gt;&#10;&lt;TextBlock Text=&quot;{Binding ElementName=usernameInput, Path=Text}&quot;/&gt;&#10;&#10;&lt;!-- 체크박스로 버튼 활성화 --&gt;&#10;&lt;CheckBox x:Name=&quot;agreeCheck&quot; Content=&quot;이용약관 동의&quot;/&gt;&#10;&lt;Button Content=&quot;가입하기&quot; IsEnabled=&quot;{Binding ElementName=agreeCheck, Path=IsChecked}&quot;/&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 5_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Slider 하나로 ProgressBar 와 TextBlock 을 동시에 갱신하는 화면을 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice5_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;Slider x:Name=&quot;vol&quot; Minimum=&quot;0&quot; Maximum=&quot;100&quot; Width=&quot;220&quot;/&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint5_1"
                                           Text="힌트: 같은 Slider 를 ElementName 으로 두 번 바인딩하면 됩니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder5_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel5_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 슬라이더 컨트롤 -->
                        <GroupBox Header="슬라이더로 스타일 조절" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="글자 크기:" VerticalAlignment="Center"/>
                                    <Slider x:Name="fontSizeSlider" Grid.Column="1" Minimum="10" Maximum="36" Value="16" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ElementName=fontSizeSlider, Path=Value, StringFormat={}{0:F0}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="두께:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <Slider x:Name="borderSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="10" Value="2"
                                            VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=borderSlider, Path=Value, StringFormat={}{0:F0}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                    <TextBlock Grid.Row="2" Text="회전:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <Slider x:Name="rotateSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="360" Value="0"
                                            VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=rotateSlider, Path=Value, StringFormat={}{0:F0}°}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </Grid>

                                <Border Margin="0,20,0,0" BorderBrush="DarkBlue" Padding="20" HorizontalAlignment="Center"
                                        BorderThickness="{Binding ElementName=borderSlider, Path=Value}">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="{Binding ElementName=rotateSlider, Path=Value}"/>
                                    </Border.RenderTransform>
                                    <TextBlock Text="스타일 미리보기" HorizontalAlignment="Center"
                                               FontSize="{Binding ElementName=fontSizeSlider, Path=Value}"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Slider x:Name=&quot;fontSizeSlider&quot; Minimum=&quot;10&quot; Maximum=&quot;36&quot; Value=&quot;16&quot;/&gt;&#10;&lt;Slider x:Name=&quot;borderSlider&quot; Minimum=&quot;0&quot; Maximum=&quot;10&quot; Value=&quot;2&quot;/&gt;&#10;&lt;Slider x:Name=&quot;rotateSlider&quot; Minimum=&quot;0&quot; Maximum=&quot;360&quot; Value=&quot;0&quot;/&gt;&#10;&#10;&lt;Border BorderThickness=&quot;{Binding ElementName=borderSlider, Path=Value}&quot;&gt;&#10;    &lt;Border.RenderTransform&gt;&#10;        &lt;RotateTransform Angle=&quot;{Binding ElementName=rotateSlider, Path=Value}&quot;/&gt;&#10;    &lt;/Border.RenderTransform&gt;&#10;    &lt;TextBlock FontSize=&quot;{Binding ElementName=fontSizeSlider, Path=Value}&quot;/&gt;&#10;&lt;/Border&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 5_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 코드에서 Binding 객체를 만들어 TextBlock(target)의 Text 를 TextBox(src)에 연결하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice5_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="private void Bind_Click(object sender, RoutedEventArgs e)&#10;{&#10;    &#10;}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="5_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint5_2"
                                           Text="힌트: new Binding(&quot;Text&quot;) { Source = src } 를 만들고 SetBinding 으로 연결합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtResult5_2" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>

                        <!-- 동기화된 슬라이더들 -->
                        <GroupBox Header="동기화된 슬라이더" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="여러 슬라이더를 TwoWay로 동기화:" Margin="0,0,0,10"/>
                                <Slider x:Name="syncSlider1" Minimum="0" Maximum="100" Value="50"/>
                                <Slider Value="{Binding ElementName=syncSlider1, Path=Value, Mode=TwoWay}"
                                        Minimum="0" Maximum="100" Margin="0,5,0,0"/>
                                <Slider Value="{Binding ElementName=syncSlider1, Path=Value, Mode=TwoWay}"
                                        Minimum="0" Maximum="100" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding ElementName=syncSlider1, Path=Value, StringFormat=현재 값: {0:F0}}"
                                           FontSize="14" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Slider x:Name=&quot;syncSlider1&quot; Value=&quot;50&quot;/&gt;&#10;&lt;Slider Value=&quot;{Binding ElementName=syncSlider1, Path=Value, Mode=TwoWay}&quot;/&gt;&#10;&lt;Slider Value=&quot;{Binding ElementName=syncSlider1, Path=Value, Mode=TwoWay}&quot;/&gt;&#10;&#10;// 모든 슬라이더가 TwoWay로 연결되어 어느 것을 움직여도 동기화됩니다"/>
                        </Expander>
                        <!-- 직접 해보기 5_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 글꼴 크기 조절기를 만드세요. Slider 값이 미리보기 글자 크기에 바로 반영됩니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice5_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;Slider x:Name=&quot;size&quot; Minimum=&quot;10&quot; Maximum=&quot;40&quot; Value=&quot;16&quot; Width=&quot;220&quot;/&gt;&#10;    &lt;TextBlock Text=&quot;미리보기 글자&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint5_3"
                                           Text="힌트: TextBlock 의 FontSize 를 Slider 의 Value 에 바인딩합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder5_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel5_3"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                                            

</StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
