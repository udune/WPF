                                           Foreground="DarkCyan" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox Text=&quot;{Binding ElementName=triggerSource, Path=Text, &#10;         Mode=TwoWay, UpdateSourceTrigger=LostFocus}&quot;/&gt;&#10;&#10;// LostFocus: 포커스를 잃을 때 소스 업데이트&#10;// TextBox.Text의 기본값 (Default와 동일)"/>
                        </Expander>
                        <!-- 직접 해보기 3_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 포커스가 빠져나갈 때만 반영되도록 UpdateSourceTrigger 를 LostFocus 로 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice3_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;TextBox x:Name=&quot;src2&quot; Width=&quot;200&quot;/&gt;&#10;    &lt;TextBox Width=&quot;200&quot; Text=&quot;{Binding ElementName=src2, Path=Text, Mode=TwoWay}&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint3_2"
                                           Text="힌트: TextBox 의 기본값이 LostFocus 지만, 명시적으로 적어 봅니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder3_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel3_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Default -->
                        <GroupBox Header="Default (속성의 기본 동작)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="각 속성의 기본 UpdateSourceTrigger 동작을 따름:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ElementName=triggerSource, Path=Text, Mode=TwoWay, UpdateSourceTrigger=Default}"
                                         Padding="5" Background="LightSteelBlue"/>
                                <TextBlock Text="※ TextBox.Text는 LostFocus가 기본값입니다" FontStyle="Italic"
                                           Foreground="SteelBlue" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox Text=&quot;{Binding ElementName=triggerSource, Path=Text, &#10;         Mode=TwoWay, UpdateSourceTrigger=Default}&quot;/&gt;&#10;&#10;// Default: 속성의 기본 UpdateSourceTrigger 사용&#10;// TextBox.Text → LostFocus&#10;// Slider.Value → PropertyChanged"/>
                        </Expander>
                        <!-- 직접 해보기 3_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Slider 값이 바뀌는 즉시 TextBox 에 반영되게 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice3_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;Slider x:Name=&quot;s6&quot; Minimum=&quot;0&quot; Maximum=&quot;100&quot; Width=&quot;220&quot;/&gt;&#10;    &lt;TextBox Width=&quot;220&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint3_3"
                                           Text="힌트: UpdateSourceTrigger=PropertyChanged 를 붙입니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder3_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel3_3"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Explicit -->
                        <GroupBox Header="Explicit (명시적 호출 필요)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="코드에서 명시적으로 UpdateSource()를 호출해야 반영:" Margin="0,0,0,5"/>
                                <TextBox x:Name="explicitTextBox"
                                         Text="{Binding ElementName=triggerSource, Path=Text, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                         Padding="5" Background="LightPink"/>
                                <Button Content="소스 업데이트" Click="UpdateExplicit_Click"
                                        Padding="10,5" Margin="0,5,0,0" HorizontalAlignment="Left"/>
                                <TextBlock Text="※ 버튼을 클릭해야만 소스가 업데이트됩니다" FontStyle="Italic"
                                           Foreground="IndianRed" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox x:Name=&quot;explicitTextBox&quot;&#10;         Text=&quot;{Binding ElementName=triggerSource, Path=Text, &#10;                  Mode=TwoWay, UpdateSourceTrigger=Explicit}&quot;/&gt;&#10;&lt;Button Content=&quot;소스 업데이트&quot; Click=&quot;UpdateExplicit_Click&quot;/&gt;&#10;&#10;// C# 코드&#10;private void UpdateExplicit_Click(object sender, RoutedEventArgs e)&#10;{&#10;    var binding = explicitTextBox.GetBindingExpression(TextBox.TextProperty);&#10;    binding?.UpdateSource();&#10;}"/>
                        </Expander>
                        <!-- 직접 해보기 3_4 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Explicit 바인딩을 쓰는 TextBox의 값을 버튼을 눌렀을 때 소스로 밀어 넣으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice3_4"
                                         Style="{StaticResource PracticeInputStyle}"
                                         AcceptsReturn="True"
                                         Text="private void UpdateExplicit_Click(object sender, RoutedEventArgs e)&#10;{&#10;    &#10;}"/>
