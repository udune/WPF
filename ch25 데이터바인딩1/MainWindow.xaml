                        </Expander>
                        <!-- 직접 해보기 2_4 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 위 TextBox의 값을 아래 TextBlock이 OneTime 모드로 한 번만 받아오게 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
