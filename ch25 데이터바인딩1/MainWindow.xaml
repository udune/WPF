                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;TextBox x:Name=&quot;oneTimeSource&quot; Text=&quot;처음 값&quot;/&gt;&#10;    &lt;TextBlock Margin=&quot;0,8,0,0&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
