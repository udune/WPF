                                         Background="LightYellow" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- PropertyChanged -->
                        <GroupBox Header="PropertyChanged (즉시 반영)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="타겟 값이 변경될 때마다 즉시 소스에 반영:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ElementName=triggerSource, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="5" Background="LightGreen"/>
                                <TextBlock Text="※ 타이핑할 때마다 즉시 소스가 업데이트됩니다" FontStyle="Italic"
                                           Foreground="Green" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox Text=&quot;{Binding ElementName=triggerSource, Path=Text, &#10;         Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}&quot;/&gt;&#10;&#10;// PropertyChanged: 속성이 변경될 때마다 즉시 소스 업데이트&#10;// 실시간 검색, 자동 완성 등에 유용"/>
                        </Expander>
                        <!-- 직접 해보기 3_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: TextBox 에 글자를 칠 때마다 즉시 반영되도록 UpdateSourceTrigger 를 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice3_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;TextBox x:Name=&quot;src&quot; Width=&quot;200&quot;/&gt;&#10;    &lt;TextBox Width=&quot;200&quot; Text=&quot;{Binding ElementName=src, Path=Text, Mode=TwoWay}&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint3_1"
                                           Text="힌트: UpdateSourceTrigger=PropertyChanged 를 추가합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder3_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel3_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- LostFocus -->
                        <GroupBox Header="LostFocus (포커스 잃을 때)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="타겟이 포커스를 잃을 때 소스에 반영:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ElementName=triggerSource, Path=Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Padding="5" Background="LightCyan"/>
