<Window x:Class="ch25_데이터바인딩1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch25_데이터바인딩1"
        mc:Ignorable="d"
        Title="ch25 데이터 바인딩 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="420"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl>
            <!-- 탭 1: 기본 사용법 -->
            <TabItem Header="기본 사용법">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="데이터 바인딩 기본 사용법" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- ElementName 바인딩 -->
                        <GroupBox Header="ElementName 바인딩" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="ElementName으로 다른 컨트롤의 속성을 바인딩합니다:" Margin="0,0,0,5"/>
                                <TextBlock Text="소스 TextBox:" Margin="0,5,0,2"/>
                                <TextBox x:Name="sourceTextBox1" Text="여기에 입력하세요" Padding="5"/>
                                <TextBlock Text="타겟 TextBlock (바인딩됨):" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding ElementName=sourceTextBox1, Path=Text}"
                                           Background="LightYellow" Padding="5"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox x:Name=&quot;sourceTextBox1&quot; Text=&quot;여기에 입력하세요&quot;/&gt;&#10;&#10;&lt;TextBlock Text=&quot;{Binding ElementName=sourceTextBox1, Path=Text}&quot;/&gt;&#10;&#10;// ElementName: 바인딩할 소스 요소의 이름&#10;// Path: 바인딩할 속성 이름"/>
                        </Expander>
                        <!-- 직접 해보기 1_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Slider 의 값을 TextBlock 에 그대로 표시하도록 ElementName 바인딩을 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;Slider x:Name=&quot;sld&quot; Minimum=&quot;0&quot; Maximum=&quot;100&quot; Width=&quot;200&quot;/&gt;&#10;    &lt;TextBlock Text=&quot;{Binding }&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_1"
                                           Text="힌트: ElementName 에 원본 컨트롤 이름을, Path 에 속성 이름을 씁니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 다양한 속성 바인딩 -->
                        <GroupBox Header="다양한 속성 바인딩" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Text 외에도 다양한 속성을 바인딩할 수 있습니다:" Margin="0,0,0,5"/>

                                <TextBlock Text="Width 바인딩 (슬라이더로 조절):" Margin="0,5,0,2"/>
                                <Slider x:Name="widthSlider" Minimum="50" Maximum="300" Value="150"/>
                                <Rectangle Width="{Binding ElementName=widthSlider, Path=Value}"
                                           Height="30" Fill="SteelBlue" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                                <TextBlock Text="Opacity 바인딩:" Margin="0,15,0,2"/>
                                <Slider x:Name="opacitySlider" Minimum="0" Maximum="1" Value="1"/>
                                <TextBlock Text="투명도가 변합니다" FontSize="16" Background="Coral" Padding="10"
                                           Opacity="{Binding ElementName=opacitySlider, Path=Value}"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- Width 바인딩 --&gt;&#10;&lt;Slider x:Name=&quot;widthSlider&quot; Minimum=&quot;50&quot; Maximum=&quot;300&quot; Value=&quot;150&quot;/&gt;&#10;&lt;Rectangle Width=&quot;{Binding ElementName=widthSlider, Path=Value}&quot; Height=&quot;30&quot; Fill=&quot;SteelBlue&quot;/&gt;&#10;&#10;&lt;!-- Opacity 바인딩 --&gt;&#10;&lt;Slider x:Name=&quot;opacitySlider&quot; Minimum=&quot;0&quot; Maximum=&quot;1&quot; Value=&quot;1&quot;/&gt;&#10;&lt;TextBlock Opacity=&quot;{Binding ElementName=opacitySlider, Path=Value}&quot;/&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: TextBox 에 입력한 글자가 아래 TextBlock 에 그대로 나타나게 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;TextBox x:Name=&quot;input&quot; Width=&quot;200&quot;/&gt;&#10;    &lt;TextBlock Text=&quot;{Binding }&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_2"
                                           Text="힌트: Path 를 Text 로 지정합니다. Path= 는 생략해도 됩니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Background 바인딩 -->
                        <GroupBox Header="Background 바인딩" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="배경색도 바인딩할 수 있습니다:" Margin="0,0,0,5"/>
                                <Button x:Name="colorSourceBtn" Content="소스 버튼 (배경색 클릭)"
                                        Background="Salmon" Padding="10,5" Click="ChangeColor_Click"/>
                                <Button Content="타겟 버튼 (배경색 바인딩됨)" Padding="10,5" Margin="0,5,0,0"
                                        Background="{Binding ElementName=colorSourceBtn, Path=Background}"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Button x:Name=&quot;colorSourceBtn&quot; Background=&quot;Salmon&quot; Content=&quot;소스 버튼&quot;/&gt;&#10;&lt;Button Background=&quot;{Binding ElementName=colorSourceBtn, Path=Background}&quot; Content=&quot;타겟 버튼&quot;/&gt;&#10;&#10;// 소스 버튼의 Background가 변경되면 타겟 버튼도 자동으로 변경됩니다"/>
                        </Expander>
                        <!-- 직접 해보기 1_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: CheckBox 의 체크 여부를 아래 TextBlock 에 그대로 표시하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;CheckBox x:Name=&quot;chk&quot; Content=&quot;동의&quot;/&gt;&#10;    &lt;TextBlock/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_3"
                                           Text="힌트: Path 를 IsChecked 로 지정합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_3"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                        
                        <!-- IsEnabled 바인딩 -->
                        <GroupBox Header="IsEnabled 바인딩" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="CheckBox의 IsChecked를 Button의 IsEnabled에 바인딩:" Margin="0,0,0,5"/>
                                <CheckBox x:Name="enableCheckBox" Content="버튼 활성화" IsChecked="True"/>
                                <Button Content="활성화/비활성화 버튼" Padding="10,5" Margin="0,5,0,0"
                                        IsEnabled="{Binding ElementName=enableCheckBox, Path=IsChecked}"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;CheckBox x:Name=&quot;enableCheckBox&quot; Content=&quot;버튼 활성화&quot; IsChecked=&quot;True&quot;/&gt;&#10;&lt;Button Content=&quot;활성화/비활성화 버튼&quot;&#10;        IsEnabled=&quot;{Binding ElementName=enableCheckBox, Path=IsChecked}&quot;/&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_4 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 체크박스를 켰을 때만 버튼이 눌리도록 IsEnabled를 ElementName 바인딩하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_4"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;CheckBox x:Name=&quot;enableCheckBox&quot; Content=&quot;버튼 활성화&quot; IsChecked=&quot;True&quot;/&gt;&#10;    &lt;Button Content=&quot;실행&quot; Margin=&quot;0,8,0,0&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_4"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_4"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_4"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_4"
                                           Text="힌트: {Binding ElementName=enableCheckBox, Path=IsChecked} 를 IsEnabled 에 넣습니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_4"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                    

</StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 2: 바인딩 모드 -->
            <TabItem Header="바인딩 모드">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="바인딩 모드 (Mode)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- OneWay -->
                        <GroupBox Header="OneWay (소스 → 타겟)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="소스가 변경되면 타겟에 반영됩니다 (단방향):" Margin="0,0,0,5"/>
                                <TextBlock Text="소스:" Margin="0,5,0,2"/>
                                <TextBox x:Name="oneWaySource" Text="OneWay 소스" Padding="5"/>
                                <TextBlock Text="타겟 (OneWay):" Margin="0,10,0,2"/>
                                <TextBox Text="{Binding ElementName=oneWaySource, Path=Text, Mode=OneWay}"
                                         Padding="5" Background="LightCyan"/>
                                <TextBlock Text="※ 타겟을 수정해도 소스에 반영되지 않습니다" FontStyle="Italic"
                                           Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox x:Name=&quot;oneWaySource&quot; Text=&quot;OneWay 소스&quot;/&gt;&#10;&lt;TextBox Text=&quot;{Binding ElementName=oneWaySource, Path=Text, Mode=OneWay}&quot;/&gt;&#10;&#10;// OneWay: 소스 → 타겟 방향으로만 데이터 전달&#10;// 대부분의 바인딩의 기본값"/>
                        </Expander>
                        <!-- 직접 해보기 2_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 두 TextBox 를 TwoWay 로 묶어 한쪽을 고치면 다른 쪽도 바뀌게 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;TextBox x:Name=&quot;a&quot; Width=&quot;200&quot; Text=&quot;처음 값&quot;/&gt;&#10;    &lt;TextBox Width=&quot;200&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_1"
                                           Text="힌트: Mode=TwoWay 를 지정합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- TwoWay -->
                        <GroupBox Header="TwoWay (소스 ↔ 타겟)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="소스와 타겟이 양방향으로 동기화됩니다:" Margin="0,0,0,5"/>
                                <TextBlock Text="소스:" Margin="0,5,0,2"/>
                                <TextBox x:Name="twoWaySource" Text="TwoWay 소스" Padding="5"/>
                                <TextBlock Text="타겟 (TwoWay) - 포커스 이동 시 반영:" Margin="0,10,0,2"/>
                                <TextBox Text="{Binding ElementName=twoWaySource, Path=Text, Mode=TwoWay}"
                                         Padding="5" Background="LightGreen"/>
                                <TextBlock Text="※ 타겟 수정 후 Tab이나 다른 곳 클릭하면 소스에 반영" FontStyle="Italic"
                                           Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox x:Name=&quot;twoWaySource&quot; Text=&quot;TwoWay 소스&quot;/&gt;&#10;&lt;TextBox Text=&quot;{Binding ElementName=twoWaySource, Path=Text, Mode=TwoWay}&quot;/&gt;&#10;&#10;// TwoWay: 소스 ↔ 타겟 양방향 데이터 전달&#10;// TextBox의 기본 바인딩 모드"/>
                        </Expander>
                        <!-- 직접 해보기 2_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Slider 값을 ProgressBar 에 OneWay 로만 전달하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel&gt;&#10;    &lt;Slider x:Name=&quot;s2&quot; Minimum=&quot;0&quot; Maximum=&quot;100&quot; Width=&quot;200&quot;/&gt;&#10;    &lt;ProgressBar Height=&quot;20&quot; Minimum=&quot;0&quot; Maximum=&quot;100&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_2"
                                           Text="힌트: Mode=OneWay 는 원본에서 대상으로만 값이 흐릅니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- OneWayToSource -->
                        <GroupBox Header="OneWayToSource (타겟 → 소스)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="타겟이 변경되면 소스에 반영됩니다 (역방향):" Margin="0,0,0,5"/>
                                <TextBlock Text="소스 (여기에 반영됨):" Margin="0,5,0,2"/>
                                <TextBox x:Name="oneWayToSourceTarget" Text="초기값" Padding="5" Background="LightPink"/>
                                <TextBlock Text="타겟 (OneWayToSource) - 여기서 입력:" Margin="0,10,0,2"/>
                                <TextBox Text="{Binding ElementName=oneWayToSourceTarget, Path=Text, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="5"/>
                                <TextBlock Text="※ 아래 텍스트박스에 입력하면 위에 반영됩니다" FontStyle="Italic"
                                           Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBox x:Name=&quot;oneWayToSourceTarget&quot; Text=&quot;초기값&quot;/&gt;&#10;&lt;TextBox Text=&quot;{Binding ElementName=oneWayToSourceTarget, Path=Text, &#10;         Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}&quot;/&gt;&#10;&#10;// OneWayToSource: 타겟 → 소스 방향으로만 데이터 전달"/>
                        </Expander>
                        <!-- 직접 해보기 2_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
