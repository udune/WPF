                                    <TextBlock Text="• 여러 프로젝트에서 재사용" Margin="5,2"/>
                                    <TextBlock Text="• 테마 전환 용이" Margin="5,2"/>
                                    <TextBlock Text="• 협업 시 충돌 감소" Margin="5,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- App.xaml --&gt;&#10;&lt;Application x:Class=&quot;ch32_스타일.App&quot;&#10;             xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&#10;             xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;&#10;             StartupUri=&quot;MainWindow.xaml&quot;&gt;&#10;    &lt;Application.Resources&gt;&#10;        &lt;ResourceDictionary&gt;&#10;            &lt;ResourceDictionary.MergedDictionaries&gt;&#10;                &lt;ResourceDictionary Source=&quot;Dictionary1.xaml&quot;/&gt;&#10;            &lt;/ResourceDictionary.MergedDictionaries&gt;&#10;        &lt;/ResourceDictionary&gt;&#10;    &lt;/Application.Resources&gt;&#10;&lt;/Application&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: TextBlock 용 공통 스타일을 리소스로 정의하고 두 개에 적용하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_2"
                                       Text="힌트: TargetType=&quot;TextBlock&quot; 스타일을 Resources 에 넣으면 자동 적용됩니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="3. 전역 스타일 사용" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Dictionary1.xaml에 정의된 스타일을 어디서나 사용할 수 있습니다:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource 버튼스타일}" Content="전역 스타일"/>
                                <Button Style="{StaticResource 버튼스타일2}" Content="전역 스타일2"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- MainWindow.xaml 또는 다른 어떤 XAML에서도 사용 가능 --&gt;&#10;&lt;Button Style=&quot;{StaticResource 버튼스타일}&quot; Content=&quot;전역 스타일&quot;/&gt;&#10;&lt;Button Style=&quot;{StaticResource 버튼스타일2}&quot; Content=&quot;전역 스타일2&quot;/&gt;&#10;&#10;&lt;!-- 리소스 조회 순서 --&gt;&#10;&lt;!-- 1. 현재 컨트롤의 Resources --&gt;&#10;&lt;!-- 2. 부모 컨트롤의 Resources --&gt;&#10;&lt;!-- 3. Window.Resources --&gt;&#10;&lt;!-- 4. Application.Resources (App.xaml) --&gt;&#10;&lt;!-- 5. 시스템 리소스 --&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 리소스에 색 브러시를 정의하고 두 곳에서 함께 참조하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &#10;    &lt;Button Content=&quot;버튼&quot; Width=&quot;140&quot;/&gt;&#10;    &lt;Border Height=&quot;30&quot; Margin=&quot;0,6,0,0&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_3"
                                       Text="힌트: SolidColorBrush 를 x:Key 로 정의하고 StaticResource 로 씁니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                    
                    <GroupBox Header="4. StaticResource vs DynamicResource" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="두 가지 리소스 참조 방법의 차이점:" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" Padding="10" Margin="0,0,5,0" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="StaticResource"/>
                                        <TextBlock Text="• 컴파일 타임 해결" Margin="0,5,0,2"/>
                                        <TextBlock Text="• 빠른 성능" Margin="0,2"/>
                                        <TextBlock Text="• 변경 시 업데이트 안 됨" Margin="0,2"/>
                                        <TextBlock Text="• 대부분의 경우 사용" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF3E0" Padding="10" Margin="5,0,0,0" CornerRadius="5" Grid.Column="1">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="DynamicResource"/>
                                        <TextBlock Text="• 런타임 해결" Margin="0,5,0,2"/>
                                        <TextBlock Text="• 상대적으로 느림" Margin="0,2"/>
                                        <TextBlock Text="• 변경 시 자동 업데이트" Margin="0,2"/>
                                        <TextBlock Text="• 테마 전환 시 사용" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- StaticResource - 정적 참조 (권장) --&gt;&#10;&lt;Button Style=&quot;{StaticResource 버튼스타일}&quot;/&gt;&#10;&#10;&lt;!-- DynamicResource - 동적 참조 --&gt;&#10;&lt;Button Style=&quot;{DynamicResource 버튼스타일}&quot;/&gt;&#10;&#10;&lt;!-- 런타임에 리소스 변경 시 --&gt;&#10;// C# 코드&#10;Application.Current.Resources[&quot;버튼스타일&quot;] = newStyle;&#10;// StaticResource: 변경 안 됨&#10;// DynamicResource: 자동 업데이트"/>
                    </Expander>
                    <!-- 직접 해보기 2_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 같은 스타일을 하나는 StaticResource로, 하나는 DynamicResource로 참조해 보세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &lt;StackPanel.Resources&gt;&#10;        &lt;Style x:Key=&quot;버튼스타일&quot; TargetType=&quot;Button&quot;&gt;&#10;            &lt;Setter Property=&quot;Background&quot; Value=&quot;#4CAF50&quot;/&gt;&#10;            &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;            &lt;Setter Property=&quot;Margin&quot; Value=&quot;0,4&quot;/&gt;&#10;        &lt;/Style&gt;&#10;    &lt;/StackPanel.Resources&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_4"
                                       Text="힌트: StaticResource 는 불러올 때 한 번, DynamicResource 는 리소스가 바뀌면 다시 읽습니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                

</StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="ControlTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="ControlTemplate으로 외관 변경" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="ControlTemplate을 사용하면 컨트롤의 시각적 구조를 완전히 재정의할 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <GroupBox Header="1. 둥근 버튼 만들기" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="ControlTemplate으로 버튼의 모서리를 둥글게 만듭니다:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="기본 버튼" Padding="15,8" Margin="5"/>
                                <Button Style="{StaticResource RoundButtonStyle}" Content="둥근 버튼"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;Style x:Key=&quot;RoundButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;DodgerBlue&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;    &lt;Setter Property=&quot;Width&quot; Value=&quot;120&quot;/&gt;&#10;    &lt;Setter Property=&quot;Height&quot; Value=&quot;40&quot;/&gt;&#10;    &lt;Setter Property=&quot;Template&quot;&gt;&#10;        &lt;Setter.Value&gt;&#10;            &lt;ControlTemplate TargetType=&quot;Button&quot;&gt;&#10;                &lt;Border CornerRadius=&quot;20&quot; &#10;                        Background=&quot;{TemplateBinding Background}&quot;&gt;&#10;                    &lt;ContentPresenter &#10;                        HorizontalAlignment=&quot;Center&quot; &#10;                        VerticalAlignment=&quot;Center&quot;/&gt;&#10;                &lt;/Border&gt;&#10;            &lt;/ControlTemplate&gt;&#10;        &lt;/Setter.Value&gt;&#10;    &lt;/Setter&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 3_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: ControlTemplate 으로 모서리가 둥근 버튼을 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Button Content=&quot;둥근 버튼&quot; Width=&quot;140&quot; Height=&quot;36&quot;&gt;&#10;    &#10;&lt;/Button&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_1"
                                       Text="힌트: Border 에 CornerRadius 를 주고 안에 ContentPresenter 를 넣습니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder3_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel3_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="2. TemplateBinding" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="TemplateBinding으로 컨트롤 속성을 템플릿에 연결합니다:" Margin="0,0,0,10"/>
                            <Border Background="#F5F5F5" Padding="10" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Margin="0,0,0,5">TemplateBinding 작동 방식:</TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="11">
                                        Button.Background (DodgerBlue)&#x0a;
                                        ↓ TemplateBinding&#x0a;
                                        Border.Background (DodgerBlue)
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;ControlTemplate TargetType=&quot;Button&quot;&gt;&#10;    &lt;Border &#10;        CornerRadius=&quot;20&quot;&#10;        Background=&quot;{TemplateBinding Background}&quot;&#10;        BorderBrush=&quot;{TemplateBinding BorderBrush}&quot;&#10;        BorderThickness=&quot;{TemplateBinding BorderThickness}&quot;&#10;        Padding=&quot;{TemplateBinding Padding}&quot;&gt;&#10;        &#10;        &lt;ContentPresenter &#10;            HorizontalAlignment=&quot;{TemplateBinding HorizontalContentAlignment}&quot;&#10;            VerticalAlignment=&quot;{TemplateBinding VerticalContentAlignment}&quot;/&gt;&#10;    &lt;/Border&gt;&#10;&lt;/ControlTemplate&gt;&#10;&#10;&lt;!-- TemplateBinding: 템플릿 내에서 부모 컨트롤 속성 참조 --&gt;&#10;&lt;!-- 단방향 바인딩 (OneWay) --&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 3_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: ContentPresenter 를 써서 버튼 내용이 가운데 오도록 템플릿을 완성하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Button Content=&quot;가운데&quot; Width=&quot;140&quot; Height=&quot;36&quot;&gt;&#10;    &lt;Button.Template&gt;&#10;        &lt;ControlTemplate TargetType=&quot;Button&quot;&gt;&#10;            &lt;Border Background=&quot;#FF9800&quot;&gt;&#10;                &#10;            &lt;/Border&gt;&#10;        &lt;/ControlTemplate&gt;&#10;    &lt;/Button.Template&gt;&#10;&lt;/Button&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_2"
                                       Text="힌트: ContentPresenter 에 HorizontalAlignment/VerticalAlignment 를 Center 로 줍니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder3_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel3_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="3. ContentPresenter" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="ContentPresenter는 버튼의 Content를 표시하는 핵심 요소입니다:" Margin="0,0,0,10"/>
                            <Border Background="#E8F5E9" Padding="10" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Margin="0,0,0,5">ContentPresenter 역할:</TextBlock>
                                    <TextBlock Text="• 버튼의 Content 속성 값을 렌더링" Margin="5,2"/>
                                    <TextBlock Text="• 텍스트, 이미지, 복합 콘텐츠 모두 지원" Margin="5,2"/>
                                    <TextBlock Text="• 템플릿에 필수 요소" Margin="5,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 간단한 텍스트 콘텐츠 --&gt;&#10;&lt;Button Content=&quot;버튼&quot;/&gt;&#10;&#10;&lt;!-- 복합 콘텐츠 --&gt;&#10;&lt;Button&gt;&#10;    &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;        &lt;Image Source=&quot;icon.png&quot; Width=&quot;16&quot;/&gt;&#10;        &lt;TextBlock Text=&quot;저장&quot; Margin=&quot;5,0,0,0&quot;/&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Button&gt;&#10;&#10;&lt;!-- ContentPresenter가 모든 종류의 Content를 표시 --&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 3_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: ControlTemplate 으로 테두리만 있는 납작한 버튼을 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Button Content=&quot;납작 버튼&quot; Width=&quot;140&quot; Height=&quot;34&quot;&gt;&#10;    &#10;&lt;/Button&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_3"
                                       Text="힌트: Border 에 Background=&quot;Transparent&quot; 와 BorderBrush 를 줍니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder3_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel3_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                    
                    <GroupBox Header="4. Template Trigger" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="ControlTemplate 내에서 Trigger를 사용하여 상태별 외관을 정의합니다:" Margin="0,0,0,10"/>
                            <Button x:Name="btnTemplateDemo" Content="마우스를 올려보세요" Width="180" Height="45">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" CornerRadius="10" Background="SteelBlue" Padding="15,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="DarkOrange"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="DarkRed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;ControlTemplate TargetType=&quot;Button&quot;&gt;&#10;    &lt;Border x:Name=&quot;border&quot; CornerRadius=&quot;10&quot; &#10;            Background=&quot;SteelBlue&quot; Padding=&quot;15,10&quot;&gt;&#10;        &lt;ContentPresenter HorizontalAlignment=&quot;Center&quot; &#10;                          VerticalAlignment=&quot;Center&quot;/&gt;&#10;    &lt;/Border&gt;&#10;    &lt;ControlTemplate.Triggers&gt;&#10;        &lt;Trigger Property=&quot;IsMouseOver&quot; Value=&quot;True&quot;&gt;&#10;            &lt;Setter TargetName=&quot;border&quot; &#10;                    Property=&quot;Background&quot; Value=&quot;DarkOrange&quot;/&gt;&#10;        &lt;/Trigger&gt;&#10;        &lt;Trigger Property=&quot;IsPressed&quot; Value=&quot;True&quot;&gt;&#10;            &lt;Setter TargetName=&quot;border&quot; &#10;                    Property=&quot;Background&quot; Value=&quot;DarkRed&quot;/&gt;&#10;        &lt;/Trigger&gt;&#10;    &lt;/ControlTemplate.Triggers&gt;&#10;&lt;/ControlTemplate&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 3_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: ControlTemplate으로 둥근 버튼을 만들고, 마우스를 올리면 주황색이 되게 Trigger를 넣으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Button Content=&quot;마우스를 올려보세요&quot; Width=&quot;180&quot; Height=&quot;40&quot;&gt;&#10;    &lt;Button.Template&gt;&#10;        &lt;ControlTemplate TargetType=&quot;Button&quot;&gt;&#10;            &#10;        &lt;/ControlTemplate&gt;&#10;    &lt;/Button.Template&gt;&#10;&lt;/Button&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_4"
                                       Text="힌트: Border 에 x:Name 을 주고, Trigger 의 Setter 에서 TargetName 으로 그 이름을 가리킵니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder3_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel3_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                

</StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="스타일 상속">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="BasedOn을 사용한 스타일 상속" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="BasedOn 속성을 사용하면 기존 스타일을 상속받아 새로운 스타일을 만들 수 있습니다. 코드 중복을 줄이고 유지보수를 쉽게 합니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <GroupBox Header="1. 베이스 스타일 정의" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="공통 속성을 가진 베이스 스타일을 먼저 정의합니다:" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource BaseButtonStyle}" Content="베이스 스타일" Background="Gray" Foreground="White"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 베이스 스타일 - 공통 속성만 정의 --&gt;&#10;&lt;Style x:Key=&quot;BaseButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;    &lt;Setter Property=&quot;FontSize&quot; Value=&quot;14&quot;/&gt;&#10;    &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot;/&gt;&#10;    &lt;Setter Property=&quot;Padding&quot; Value=&quot;15,8&quot;/&gt;&#10;    &lt;Setter Property=&quot;Margin&quot; Value=&quot;5&quot;/&gt;&#10;    &lt;Setter Property=&quot;Cursor&quot; Value=&quot;Hand&quot;/&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 4_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 기본 스타일을 만들고 BasedOn 으로 물려받은 스타일을 하나 더 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &lt;StackPanel.Resources&gt;&#10;        &lt;Style x:Key=&quot;Base&quot; TargetType=&quot;Button&quot;&gt;&#10;            &lt;Setter Property=&quot;FontSize&quot; Value=&quot;14&quot;/&gt;&#10;            &lt;Setter Property=&quot;Padding&quot; Value=&quot;8,4&quot;/&gt;&#10;        &lt;/Style&gt;&#10;        &#10;    &lt;/StackPanel.Resources&gt;&#10;    &lt;Button Content=&quot;기본&quot; Style=&quot;{StaticResource Base}&quot; Width=&quot;140&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_1"
                                       Text="힌트: BasedOn=&quot;{StaticResource Base}&quot; 로 상속합니다. 정답에는 강조 버튼도 함께 들어갑니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="2. 파생 스타일 정의" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="BasedOn으로 베이스 스타일을 상속받아 새 스타일을 만듭니다:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Primary"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Secondary"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- Primary 스타일 - BaseButtonStyle 상속 --&gt;&#10;&lt;Style x:Key=&quot;PrimaryButtonStyle&quot; TargetType=&quot;Button&quot; &#10;       BasedOn=&quot;{StaticResource BaseButtonStyle}&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;#007ACC&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;&lt;/Style&gt;&#10;&#10;&lt;!-- Secondary 스타일 - BaseButtonStyle 상속 --&gt;&#10;&lt;Style x:Key=&quot;SecondaryButtonStyle&quot; TargetType=&quot;Button&quot; &#10;       BasedOn=&quot;{StaticResource BaseButtonStyle}&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;#6C757D&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 4_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 상속받은 스타일에서 부모가 정한 FontSize 를 20 으로 덮어쓰세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &lt;StackPanel.Resources&gt;&#10;        &lt;Style x:Key=&quot;Base2&quot; TargetType=&quot;TextBlock&quot;&gt;&#10;            &lt;Setter Property=&quot;FontSize&quot; Value=&quot;12&quot;/&gt;&#10;            &lt;Setter Property=&quot;Foreground&quot; Value=&quot;Gray&quot;/&gt;&#10;        &lt;/Style&gt;&#10;        &#10;    &lt;/StackPanel.Resources&gt;&#10;    &lt;TextBlock Text=&quot;보통 글씨&quot; Style=&quot;{StaticResource Base2}&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_2"
                                       Text="힌트: 같은 속성을 다시 Setter 로 지정하면 자식 스타일이 이깁니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="3. 상속의 장점" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="스타일 상속을 사용하면 다음과 같은 장점이 있습니다:" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFEBEE" Padding="10" Margin="0,0,5,0" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Foreground="Red">상속 없이 (중복 코드)</TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="10" Margin="0,5,0,0">
                                            Style1: 7개 Setter&#x0a;Style2: 7개 Setter&#x0a;Style3: 7개 Setter&#x0a;총 21개 Setter
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="#E8F5E9" Padding="10" Margin="5,0,0,0" CornerRadius="5" Grid.Column="1">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Foreground="Green">상속 사용 (중복 제거)</TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="10" Margin="0,5,0,0">
                                            BaseStyle: 5개 Setter&#x0a;Style1: 2개 Setter&#x0a;Style2: 2개 Setter&#x0a;총 9개 Setter
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 상속의 장점 --&gt;&#10;&#10;1. 코드 중복 제거&#10;   - 공통 속성을 한 곳에서 관리&#10;&#10;2. 유지보수 용이&#10;   - BaseStyle 수정 시 모든 파생 스타일에 반영&#10;&#10;3. 일관성 유지&#10;   - 모든 버튼이 같은 기본 특성 공유&#10;&#10;4. 확장성&#10;   - 새로운 스타일 추가가 쉬움&#10;   - BasedOn만 지정하면 됨&#10;&#10;&lt;!-- 다단계 상속도 가능 --&gt;&#10;&lt;Style x:Key=&quot;DangerButtonStyle&quot; &#10;       BasedOn=&quot;{StaticResource PrimaryButtonStyle}&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;Red&quot;/&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 4_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 기본 TextBlock 스타일을 만들고, 이를 물려받아 경고용 빨간 스타일을 추가하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_3"
                                       Text="힌트: BasedOn 으로 상속한 뒤 Foreground 만 덮어씁니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                    
                    <GroupBox Header="4. 실용적인 버튼 세트" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="실제 애플리케이션에서 사용할 수 있는 버튼 스타일 세트:" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="저장"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="취소"/>
                                <Button Style="{StaticResource BaseButtonStyle}" Background="#28A745" Foreground="White" Content="확인"/>
                                <Button Style="{StaticResource BaseButtonStyle}" Background="#DC3545" Foreground="White" Content="삭제"/>
                                <Button Style="{StaticResource BaseButtonStyle}" Background="#FFC107" Foreground="Black" Content="경고"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- Bootstrap 스타일 버튼 세트 예제 --&gt;&#10;&#10;&lt;Style x:Key=&quot;SuccessButtonStyle&quot; BasedOn=&quot;{StaticResource BaseButtonStyle}&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;#28A745&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;&lt;/Style&gt;&#10;&#10;&lt;Style x:Key=&quot;DangerButtonStyle&quot; BasedOn=&quot;{StaticResource BaseButtonStyle}&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;#DC3545&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;&lt;/Style&gt;&#10;&#10;&lt;Style x:Key=&quot;WarningButtonStyle&quot; BasedOn=&quot;{StaticResource BaseButtonStyle}&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;#FFC107&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;Black&quot;/&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 4_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: BasedOn으로 기본 버튼 스타일을 물려받는 '성공'·'위험' 스타일 두 개를 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice4_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &lt;StackPanel.Resources&gt;&#10;        &lt;Style x:Key=&quot;BaseButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;            &lt;Setter Property=&quot;Padding&quot; Value=&quot;12,6&quot;/&gt;&#10;            &lt;Setter Property=&quot;Margin&quot; Value=&quot;0,4&quot;/&gt;&#10;            &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot;/&gt;&#10;        &lt;/Style&gt;&#10;        &#10;    &lt;/StackPanel.Resources&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="4_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="4_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="4_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint4_4"
                                       Text="힌트: BasedOn=&quot;{StaticResource BaseButtonStyle}&quot; 을 쓰면 부모 Setter 를 모두 물려받습니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder4_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel4_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                

</StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="트리거">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Style Trigger로 동적 스타일 적용" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Trigger를 사용하면 특정 조건에 따라 스타일을 동적으로 변경할 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <GroupBox Header="1. Property Trigger" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="속성 값에 따라 스타일을 변경합니다 (마우스를 올려보세요):" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource TriggerButtonStyle}" Content="Hover &amp; Click"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;Style x:Key=&quot;TriggerButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;LightBlue&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;Black&quot;/&gt;&#10;    &lt;Setter Property=&quot;FontSize&quot; Value=&quot;14&quot;/&gt;&#10;    &lt;Setter Property=&quot;Padding&quot; Value=&quot;20,10&quot;/&gt;&#10;    &#10;    &lt;Style.Triggers&gt;&#10;        &lt;!-- 마우스 오버 시 --&gt;&#10;        &lt;Trigger Property=&quot;IsMouseOver&quot; Value=&quot;True&quot;&gt;&#10;            &lt;Setter Property=&quot;Background&quot; Value=&quot;DeepSkyBlue&quot;/&gt;&#10;            &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;        &lt;/Trigger&gt;&#10;        &#10;        &lt;!-- 클릭 시 --&gt;&#10;        &lt;Trigger Property=&quot;IsPressed&quot; Value=&quot;True&quot;&gt;&#10;            &lt;Setter Property=&quot;Background&quot; Value=&quot;DarkBlue&quot;/&gt;&#10;            &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;        &lt;/Trigger&gt;&#10;    &lt;/Style.Triggers&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 5_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 마우스를 올리면 배경이 주황색으로 바뀌는 Trigger 를 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Button Content=&quot;마우스를 올려보세요&quot; Width=&quot;180&quot; Height=&quot;34&quot;&gt;&#10;    &lt;Button.Style&gt;&#10;        &lt;Style TargetType=&quot;Button&quot;&gt;&#10;            &#10;        &lt;/Style&gt;&#10;    &lt;/Button.Style&gt;&#10;&lt;/Button&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_1"
                                       Text="힌트: &lt;Style.Triggers&gt;&lt;Trigger Property=&quot;IsMouseOver&quot; Value=&quot;True&quot;&gt;..."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="2. IsEnabled Trigger" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="활성화/비활성화 상태에 따른 스타일 변경:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="활성화" Padding="15,8" Margin="5">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="LimeGreen"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="Gray"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="비활성화" IsEnabled="False" Padding="15,8" Margin="5">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="LimeGreen"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="Gray"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;Style TargetType=&quot;Button&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;LimeGreen&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;    &#10;    &lt;Style.Triggers&gt;&#10;        &lt;Trigger Property=&quot;IsEnabled&quot; Value=&quot;False&quot;&gt;&#10;            &lt;Setter Property=&quot;Background&quot; Value=&quot;Gray&quot;/&gt;&#10;            &lt;Setter Property=&quot;Opacity&quot; Value=&quot;0.5&quot;/&gt;&#10;        &lt;/Trigger&gt;&#10;    &lt;/Style.Triggers&gt;&#10;&lt;/Style&gt;&#10;&#10;&lt;Button Content=&quot;활성화&quot;/&gt;&#10;&lt;Button Content=&quot;비활성화&quot; IsEnabled=&quot;False&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 5_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 조건 두 개(IsMouseOver 와 IsEnabled)를 동시에 만족할 때만 반응하는 MultiTrigger 를 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Button Content=&quot;멀티 트리거&quot; Width=&quot;180&quot; Height=&quot;34&quot;&gt;&#10;    &lt;Button.Style&gt;&#10;        &lt;Style TargetType=&quot;Button&quot;&gt;&#10;            &lt;Style.Triggers&gt;&#10;                &#10;            &lt;/Style.Triggers&gt;&#10;        &lt;/Style&gt;&#10;    &lt;/Button.Style&gt;&#10;&lt;/Button&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_2"
                                       Text="힌트: &lt;MultiTrigger&gt;&lt;MultiTrigger.Conditions&gt;&lt;Condition .../&gt;&lt;/MultiTrigger.Conditions&gt;"
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="3. MultiTrigger" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="여러 조건을 동시에 만족할 때 스타일을 변경합니다:" Margin="0,0,0,10"/>
                            <CheckBox x:Name="chkFocus" Content="IsFocused 시뮬레이션" Margin="0,0,0,10"/>
                            <Button Content="Focus + Hover" Padding="20,10" Margin="5">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="LightGray"/>
                                        <Style.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsFocused" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="버튼을 클릭(포커스)한 후 마우스를 올려보세요." FontStyle="Italic" Foreground="Gray" Margin="5,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;Style TargetType=&quot;Button&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;LightGray&quot;/&gt;&#10;    &#10;    &lt;Style.Triggers&gt;&#10;        &lt;!-- 여러 조건을 AND로 결합 --&gt;&#10;        &lt;MultiTrigger&gt;&#10;            &lt;MultiTrigger.Conditions&gt;&#10;                &lt;Condition Property=&quot;IsMouseOver&quot; Value=&quot;True&quot;/&gt;&#10;                &lt;Condition Property=&quot;IsFocused&quot; Value=&quot;True&quot;/&gt;&#10;            &lt;/MultiTrigger.Conditions&gt;&#10;            &lt;Setter Property=&quot;Background&quot; Value=&quot;Gold&quot;/&gt;&#10;            &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot;/&gt;&#10;        &lt;/MultiTrigger&gt;&#10;    &lt;/Style.Triggers&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 5_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: CheckBox 가 체크되면 글자가 초록색으로 바뀌는 트리거를 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;CheckBox Content=&quot;완료&quot;&gt;&#10;    &lt;CheckBox.Style&gt;&#10;        &lt;Style TargetType=&quot;CheckBox&quot;&gt;&#10;            &#10;        &lt;/Style&gt;&#10;    &lt;/CheckBox.Style&gt;&#10;&lt;/CheckBox&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_3"
                                       Text="힌트: Trigger Property=&quot;IsChecked&quot; Value=&quot;True&quot; 를 씁니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                    
                    <GroupBox Header="4. 자주 사용하는 Trigger 속성" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="WPF에서 자주 사용하는 Trigger 조건들:" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E3F2FD" Padding="10" Margin="0,0,5,0" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,5">Button/Control</TextBlock>
                                        <TextBlock Text="• IsMouseOver" Margin="5,2"/>
                                        <TextBlock Text="• IsPressed" Margin="5,2"/>
                                        <TextBlock Text="• IsFocused" Margin="5,2"/>
                                        <TextBlock Text="• IsEnabled" Margin="5,2"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF3E0" Padding="10" Margin="5,0,0,0" CornerRadius="5" Grid.Column="1">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,5">CheckBox/RadioButton</TextBlock>
                                        <TextBlock Text="• IsChecked" Margin="5,2"/>
                                        <TextBlock Text="• IsMouseOver" Margin="5,2"/>
                                        <TextBlock Text="• IsFocused" Margin="5,2"/>
                                        <TextBlock Text="• IsEnabled" Margin="5,2"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- CheckBox 스타일 예제 --&gt;&#10;&lt;Style TargetType=&quot;CheckBox&quot;&gt;&#10;    &lt;Style.Triggers&gt;&#10;        &lt;Trigger Property=&quot;IsChecked&quot; Value=&quot;True&quot;&gt;&#10;            &lt;Setter Property=&quot;Foreground&quot; Value=&quot;Green&quot;/&gt;&#10;            &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot;/&gt;&#10;        &lt;/Trigger&gt;&#10;    &lt;/Style.Triggers&gt;&#10;&lt;/Style&gt;&#10;&#10;&lt;!-- TextBox 스타일 예제 --&gt;&#10;&lt;Style TargetType=&quot;TextBox&quot;&gt;&#10;    &lt;Style.Triggers&gt;&#10;        &lt;Trigger Property=&quot;IsFocused&quot; Value=&quot;True&quot;&gt;&#10;            &lt;Setter Property=&quot;BorderBrush&quot; Value=&quot;Blue&quot;/&gt;&#10;            &lt;Setter Property=&quot;BorderThickness&quot; Value=&quot;2&quot;/&gt;&#10;        &lt;/Trigger&gt;&#10;    &lt;/Style.Triggers&gt;&#10;&lt;/Style&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 5_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 체크하면 글자가 초록색 굵은 글씨로 바뀌는 CheckBox 스타일을 Trigger로 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &lt;StackPanel.Resources&gt;&#10;        &lt;Style TargetType=&quot;CheckBox&quot;&gt;&#10;            &#10;        &lt;/Style&gt;&#10;    &lt;/StackPanel.Resources&gt;&#10;    &lt;CheckBox Content=&quot;체크해 보세요&quot; Margin=&quot;0,4&quot;/&gt;&#10;    &lt;CheckBox Content=&quot;이것도 체크해 보세요&quot; Margin=&quot;0,4&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_4"
                                       Text="힌트: Style.Triggers 안에 &lt;Trigger Property=&quot;IsChecked&quot; Value=&quot;True&quot;&gt; 를 넣고 Setter 를 답니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                

</StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
