<Window x:Class="ch32_스타일.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch32_스타일"
        mc:Ignorable="d"
        Title="ch32 스타일 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="300"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SampleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Salmon"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGreen"/>
            <Setter Property="Foreground" Value="DarkGreen"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="DodgerBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="20" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="TriggerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="DeepSkyBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="DarkBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <TabControl>
        <TabItem Header="기본 스타일">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Style 기본 사용법" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Style은 여러 속성을 하나로 묶어 컨트롤에 적용할 수 있는 리소스입니다. 일관된 UI를 유지하고 코드 중복을 줄일 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <GroupBox Header="1. Style 정의하기" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Window.Resources 안에 Style을 정의하고 x:Key로 이름을 지정합니다:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SampleButtonStyle}" Content="스타일 적용"/>
                                <Button Content="스타일 없음" Margin="5" Padding="15,8"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;Window.Resources&gt;&#10;    &lt;Style x:Key=&quot;SampleButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;        &lt;Setter Property=&quot;Background&quot; Value=&quot;Salmon&quot;/&gt;&#10;        &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;        &lt;Setter Property=&quot;FontSize&quot; Value=&quot;14&quot;/&gt;&#10;        &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot;/&gt;&#10;        &lt;Setter Property=&quot;Padding&quot; Value=&quot;15,8&quot;/&gt;&#10;        &lt;Setter Property=&quot;Margin&quot; Value=&quot;5&quot;/&gt;&#10;        &lt;Setter Property=&quot;Cursor&quot; Value=&quot;Hand&quot;/&gt;&#10;    &lt;/Style&gt;&#10;&lt;/Window.Resources&gt;&#10;&#10;&lt;!-- 스타일 적용 --&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; Content=&quot;스타일 적용&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Button 하나에 Style 을 직접 지정해 글자 크기 16, 굵게로 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Button Content=&quot;스타일 적용&quot; Width=&quot;140&quot;&gt;&#10;    &#10;&lt;/Button&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_1"
                                       Text="힌트: &lt;Button.Style&gt;&lt;Style TargetType=&quot;Button&quot;&gt;&lt;Setter .../&gt;&lt;/Style&gt;&lt;/Button.Style&gt;"
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="2. 여러 버튼에 동일 스타일 적용" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="같은 스타일을 여러 컨트롤에 적용하여 일관성을 유지합니다:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SampleButtonStyle}" Content="버튼 1"/>
                                <Button Style="{StaticResource SampleButtonStyle}" Content="버튼 2"/>
                                <Button Style="{StaticResource SampleButtonStyle}" Content="버튼 3"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 동일한 스타일을 여러 버튼에 적용 --&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; Content=&quot;버튼 1&quot;/&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; Content=&quot;버튼 2&quot;/&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; Content=&quot;버튼 3&quot;/&gt;&#10;&#10;&lt;!-- 장점 --&gt;&#10;&lt;!-- 1. 코드 중복 제거 --&gt;&#10;&lt;!-- 2. 스타일 수정 시 모든 버튼에 반영 --&gt;&#10;&lt;!-- 3. 일관된 UI 유지 --&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: StackPanel.Resources 에 x:Key 를 가진 스타일을 정의하고 버튼 하나에만 적용하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &#10;    &lt;Button Content=&quot;적용됨&quot; Width=&quot;140&quot;/&gt;&#10;    &lt;Button Content=&quot;적용 안 됨&quot; Width=&quot;140&quot; Margin=&quot;0,6,0,0&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_2"
                                       Text="힌트: Style=&quot;{StaticResource 키이름}&quot; 으로 참조합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="3. 다양한 스타일 정의" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="목적에 따라 여러 스타일을 정의하고 선택적으로 적용합니다:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SampleButtonStyle}" Content="Salmon"/>
                                <Button Style="{StaticResource GreenButtonStyle}" Content="Green"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 여러 스타일 정의 --&gt;&#10;&lt;Style x:Key=&quot;SampleButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;Salmon&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;&lt;/Style&gt;&#10;&#10;&lt;Style x:Key=&quot;GreenButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;    &lt;Setter Property=&quot;Background&quot; Value=&quot;LightGreen&quot;/&gt;&#10;    &lt;Setter Property=&quot;Foreground&quot; Value=&quot;DarkGreen&quot;/&gt;&#10;&lt;/Style&gt;&#10;&#10;&lt;!-- 상황에 맞는 스타일 적용 --&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; Content=&quot;Salmon&quot;/&gt;&#10;&lt;Button Style=&quot;{StaticResource GreenButtonStyle}&quot; Content=&quot;Green&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: TextBlock 에 스타일을 직접 붙여 글자색과 여백을 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;TextBlock Text=&quot;스타일 연습&quot;&gt;&#10;    &#10;&lt;/TextBlock&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_3"
                                       Text="힌트: &lt;TextBlock.Style&gt;&lt;Style TargetType=&quot;TextBlock&quot;&gt; 구조입니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                    
                    <GroupBox Header="4. 로컬 속성 재정의" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="스타일이 적용된 컨트롤에서 개별 속성을 재정의할 수 있습니다:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SampleButtonStyle}" Content="기본"/>
                                <Button Style="{StaticResource SampleButtonStyle}" Content="배경 변경" Background="Purple"/>
                                <Button Style="{StaticResource SampleButtonStyle}" Content="폰트 변경" FontSize="18"/>
                            </StackPanel>
                            <TextBlock Text="※ 로컬에서 설정한 속성이 스타일보다 우선합니다."
                                       FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 스타일 적용 + 로컬 속성 재정의 --&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; Content=&quot;기본&quot;/&gt;&#10;&#10;&lt;!-- Background 속성만 재정의 --&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; &#10;        Content=&quot;배경 변경&quot; &#10;        Background=&quot;Purple&quot;/&gt;&#10;&#10;&lt;!-- FontSize 속성만 재정의 --&gt;&#10;&lt;Button Style=&quot;{StaticResource SampleButtonStyle}&quot; &#10;        Content=&quot;폰트 변경&quot; &#10;        FontSize=&quot;18&quot;/&gt;&#10;&#10;&lt;!-- 적용 순서: 스타일 → 로컬 속성 (로컬이 우선) --&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 버튼 3개에 같은 스타일을 적용하되, 가운데 버튼만 Background를 Purple로 덮어쓰세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &lt;StackPanel.Resources&gt;&#10;        &lt;Style x:Key=&quot;SampleButtonStyle&quot; TargetType=&quot;Button&quot;&gt;&#10;            &lt;Setter Property=&quot;Background&quot; Value=&quot;SteelBlue&quot;/&gt;&#10;            &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;            &lt;Setter Property=&quot;Margin&quot; Value=&quot;0,4&quot;/&gt;&#10;        &lt;/Style&gt;&#10;    &lt;/StackPanel.Resources&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_4"
                                       Text="힌트: 스타일보다 태그에 직접 쓴 속성이 우선합니다. Background=&quot;Purple&quot; 을 그냥 덧붙이세요."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                

</StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="전역 리소스">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="ResourceDictionary와 전역 리소스" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="ResourceDictionary를 사용하면 스타일을 별도 파일로 분리하여 애플리케이션 전체에서 공유할 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <GroupBox Header="1. ResourceDictionary 파일 구조" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="스타일을 별도의 XAML 파일로 분리합니다:" Margin="0,0,0,10"/>
                            <Border Background="#F5F5F5" Padding="10" CornerRadius="5">
                                <TextBlock FontFamily="Consolas" FontSize="12">
                                    📁 프로젝트&#x0a;
                                    ├── App.xaml (MergedDictionaries)&#x0a;
                                    ├── MainWindow.xaml&#x0a;
                                    └── Dictionary1.xaml (스타일 정의)
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- Dictionary1.xaml --&gt;&#10;&lt;ResourceDictionary &#10;    xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&#10;    xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;&gt;&#10;&#10;    &lt;Style TargetType=&quot;Button&quot; x:Key=&quot;버튼스타일&quot;&gt;&#10;        &lt;Setter Property=&quot;Background&quot; Value=&quot;Salmon&quot;/&gt;&#10;        &lt;Setter Property=&quot;Foreground&quot; Value=&quot;White&quot;/&gt;&#10;        &lt;Setter Property=&quot;FontSize&quot; Value=&quot;20&quot;/&gt;&#10;        &lt;Setter Property=&quot;FontWeight&quot; Value=&quot;Bold&quot;/&gt;&#10;        &lt;Setter Property=&quot;Cursor&quot; Value=&quot;Hand&quot;/&gt;&#10;    &lt;/Style&gt;&#10;&lt;/ResourceDictionary&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: x:Key 없이 TargetType 만 지정해, 안의 모든 Button 에 자동 적용되는 스타일을 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StackPanel&gt;&#10;    &#10;    &lt;Button Content=&quot;첫째&quot; Width=&quot;140&quot;/&gt;&#10;    &lt;Button Content=&quot;둘째&quot; Width=&quot;140&quot; Margin=&quot;0,6,0,0&quot;/&gt;&#10;&lt;/StackPanel&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_1"
                                       Text="힌트: x:Key 를 빼면 그 범위의 모든 대상 타입에 암시적으로 적용됩니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <GroupBox Header="2. App.xaml에서 병합" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="App.xaml에서 MergedDictionaries로 ResourceDictionary를 병합합니다:" Margin="0,0,0,10"/>
