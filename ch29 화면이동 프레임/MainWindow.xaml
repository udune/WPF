                                           Text="힌트: NavigationService.RemoveBackEntry() 를 더 이상 없을 때까지 반복합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtResult5_3" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        
                        <!-- 탐색 취소 -->
                        <GroupBox Header="탐색 확인 및 취소" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                    OnNavigatingFrom에서 탐색을 취소할 수 있습니다.
                                    저장되지 않은 데이터 확인 등에 활용됩니다.
                                </TextBlock>
                                <Border Background="LightCoral" Padding="10" CornerRadius="5">
                                    <TextBlock Text="e.Cancel = true; → 탐색이 취소됨" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="protected override void OnNavigatingFrom(NavigatingCancelEventArgs e)&#10;{&#10;    base.OnNavigatingFrom(e);&#10;    &#10;    if (hasUnsavedChanges)&#10;    {&#10;        var result = MessageBox.Show(&#10;            &quot;저장하지 않은 변경사항이 있습니다.\n계속하시겠습니까?&quot;,&#10;            &quot;확인&quot;,&#10;            MessageBoxButton.YesNo);&#10;        &#10;        if (result == MessageBoxResult.No)&#10;        {&#10;            e.Cancel = true; // 탐색 취소&#10;        }&#10;    }&#10;}"/>
                        </Expander>
                        <!-- 직접 해보기 5_4 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 저장하지 않은 변경이 있으면 물어보고, '아니오'면 페이지 이동을 취소하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice5_4"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Height="120" AcceptsReturn="True"
                                         Text="protected override void OnNavigatingFrom(NavigatingCancelEventArgs e)&#10;{&#10;    base.OnNavigatingFrom(e);&#10;&#10;    &#10;}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="5_4"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_4"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_4"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint5_4"
                                           Text="힌트: MessageBoxResult.No 일 때 e.Cancel = true; 로 탐색을 막습니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtResult5_4" Margin="0,8,0,0" FontWeight="Bold"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                    

</StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
