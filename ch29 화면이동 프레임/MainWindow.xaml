<Window x:Class="ch29_화면이동_프레임.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch29_화면이동_프레임"
        mc:Ignorable="d"
        Title="ch29 Frame 화면이동 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="300"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl>
            <!-- 탭 1: 실습 -->
            <TabItem Header="실습">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 네비게이션 바 -->
                    <Border Grid.Row="0" Background="#2196F3" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="◀ 뒤로" Click="Back_Click" Width="80" Margin="5,0"
                                    Background="#1976D2" Foreground="White" BorderThickness="0" Padding="10,5"/>
                            <Button Content="앞으로 ▶" Click="Forward_Click" Width="80" Margin="5,0"
                                    Background="#1976D2" Foreground="White" BorderThickness="0" Padding="10,5"/>
                            <Button Content="🏠 홈" Click="Home_Click" Width="80" Margin="5,0"
                                    Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="10,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Frame 영역 -->
                    <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="20,10">
                        <Frame x:Name="mainFrame" Source="/Views/Page1.xaml" NavigationUIVisibility="Hidden"/>
                    </Border>

                    <!-- 상태 표시 -->
                    <Border Grid.Row="2" Background="#F5F5F5" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="탐색 기록: " FontWeight="Bold"/>
                            <TextBlock x:Name="navStatus" Text="뒤로: 불가 | 앞으로: 불가"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 탭 2: Frame 기초 -->
            <TabItem Header="Frame 기초">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Frame 컨트롤" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- Frame이란? -->
                        <GroupBox Header="Frame이란?" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                    <Run FontWeight="Bold">Frame</Run>
                                    <Run>은 Page를 호스팅하고 탐색 기능을 제공하는 컨트롤입니다.</Run>
                                    <LineBreak/>
                                    <Run>웹 브라우저처럼 뒤로/앞으로 이동이 가능하며, 탐색 기록을 관리합니다.</Run>
                                </TextBlock>
                                <Border Background="LightYellow" Padding="10" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="Frame의 주요 특징:" FontWeight="Bold"/>
                                        <TextBlock Text="• Page 컨트롤을 호스팅"/>
                                        <TextBlock Text="• NavigationService 제공"/>
                                        <TextBlock Text="• 탐색 기록 (뒤로/앞으로) 관리"/>
                                        <TextBlock Text="• Journal (탐색 일지) 유지"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- 기본 Frame 선언 --&gt;&#10;&lt;Frame x:Name=&quot;mainFrame&quot;&#10;       Source=&quot;/Views/Page1.xaml&quot;&#10;       NavigationUIVisibility=&quot;Hidden&quot;/&gt;&#10;&#10;&lt;!-- 속성 설명 --&gt;&#10;&lt;!-- Source: 초기에 로드할 Page 경로 --&gt;&#10;&lt;!-- NavigationUIVisibility: 내장 탐색 UI 표시 여부 --&gt;&#10;&lt;!--   Hidden: 숨김 (커스텀 UI 사용 시) --&gt;&#10;&lt;!--   Visible: 표시 --&gt;&#10;&lt;!--   Automatic: 자동 --&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 2_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Frame 을 하나 배치하고 테두리가 보이도록 BorderBrush 와 BorderThickness 를 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Frame Height=&quot;120&quot;/&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_1"
                                           Text="힌트: Frame 도 일반 컨트롤처럼 테두리 속성을 가집니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Frame vs Window -->
                        <GroupBox Header="Frame vs Window" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="LightBlue" Padding="15" CornerRadius="5" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Frame + Page" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="• 동일 창 내 화면 전환" Margin="0,5,0,0"/>
                                        <TextBlock Text="• 탐색 기록 자동 관리"/>
                                        <TextBlock Text="• 뒤로/앞으로 지원"/>
                                        <TextBlock Text="• 마법사, 설정 화면에 적합"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="LightCoral" Padding="15" CornerRadius="5" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="별도 Window" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="• 새 창 열기" Margin="0,5,0,0"/>
                                        <TextBlock Text="• 독립적인 수명주기"/>
                                        <TextBlock Text="• Show() / ShowDialog()"/>
                                        <TextBlock Text="• 대화상자, 팝업에 적합"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="// Frame + Page 방식&#10;mainFrame.Navigate(new SettingsPage());&#10;&#10;// 별도 Window 방식&#10;var dialog = new SettingsWindow();&#10;dialog.ShowDialog();"/>
                        </Expander>
                        <!-- 직접 해보기 2_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Frame 의 기본 탐색 막대(뒤로/앞으로 버튼)를 숨기세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Frame Height=&quot;120&quot; BorderBrush=&quot;Gray&quot; BorderThickness=&quot;1&quot;/&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_2"
                                           Text="힌트: NavigationUIVisibility=&quot;Hidden&quot; 을 지정합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 탐색 UI 옵션 -->
                        <GroupBox Header="NavigationUIVisibility 옵션" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#E3F2FD" Padding="10" CornerRadius="5" Width="160" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Hidden" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="탐색 UI 숨김" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#E8F5E9" Padding="10" CornerRadius="5" Width="160" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Visible" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="항상 표시" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FFF3E0" Padding="10" CornerRadius="5" Width="160">
                                        <StackPanel>
                                            <TextBlock Text="Automatic" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="필요 시 표시" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="보통 Hidden으로 설정하고 커스텀 네비게이션 버튼을 사용합니다."
                                           Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- 탐색 UI 숨기기 (권장) --&gt;&#10;&lt;Frame NavigationUIVisibility=&quot;Hidden&quot;/&gt;&#10;&#10;&lt;!-- 커스텀 네비게이션 버튼 --&gt;&#10;&lt;Button Content=&quot;뒤로&quot; Click=&quot;Back_Click&quot;/&gt;&#10;&lt;Button Content=&quot;앞으로&quot; Click=&quot;Forward_Click&quot;/&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 2_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Frame 을 위쪽 제목 줄 아래에 채워 넣는 레이아웃을 만드세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;DockPanel Height=&quot;160&quot;&gt;&#10;    &#10;&lt;/DockPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_3"
                                           Text="힌트: 제목은 Dock=&quot;Top&quot;, Frame 은 마지막 자식으로 두면 남은 공간을 채웁니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_3"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                                            

</StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 3: Page 클래스 -->
            <TabItem Header="Page 클래스">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Page 클래스" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- Page란? -->
                        <GroupBox Header="Page란?" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                    <Run FontWeight="Bold">Page</Run>
                                    <Run>는 Frame 내에서 호스팅되는 화면 단위입니다.</Run>
                                    <LineBreak/>
                                    <Run>Window와 비슷하지만 독립적인 창이 아닌 Frame 내부에서 표시됩니다.</Run>
                                </TextBlock>
                                <Border Background="LightGreen" Padding="10" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="Page 생성 방법:" FontWeight="Bold"/>
                                        <TextBlock Text="1. 프로젝트 우클릭 → 추가 → 새 항목"/>
                                        <TextBlock Text="2. WPF → Page (WPF) 선택"/>
                                        <TextBlock Text="3. 이름 지정 후 추가"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;!-- Page1.xaml --&gt;&#10;&lt;Page x:Class=&quot;MyApp.Views.Page1&quot;&#10;      xmlns=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot;&#10;      xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;&#10;      Title=&quot;Page1&quot;&#10;      Background=&quot;Salmon&quot;&gt;&#10;    &#10;    &lt;StackPanel&gt;&#10;        &lt;Label FontSize=&quot;20&quot;&gt;페이지1&lt;/Label&gt;&#10;        &lt;Button Content=&quot;다음&quot; Click=&quot;Next_Click&quot;/&gt;&#10;    &lt;/StackPanel&gt;&#10;&lt;/Page&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 3_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Page 안에 들어갈 내용을 StackPanel 로 구성해 보세요. 제목과 설명 두 줄이 필요합니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice3_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel Margin=&quot;10&quot;&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint3_1"
                                           Text="힌트: TextBlock 두 개를 세로로 쌓습니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder3_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel3_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Page vs UserControl -->
                        <GroupBox Header="Page vs UserControl" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E1F5FE" Padding="15" CornerRadius="5" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Page" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="• Frame에서만 사용" Margin="0,5,0,0"/>
                                        <TextBlock Text="• NavigationService 제공"/>
                                        <TextBlock Text="• 전체 화면 전환용"/>
                                        <TextBlock Text="• 탐색 기록 관리"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#F3E5F5" Padding="15" CornerRadius="5" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="UserControl" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="• 어디서나 사용 가능" Margin="0,5,0,0"/>
                                        <TextBlock Text="• 재사용 가능한 컴포넌트"/>
                                        <TextBlock Text="• 부분 UI 구성"/>
                                        <TextBlock Text="• 탐색 기능 없음"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="// Page - Frame 내에서 탐색&#10;public partial class Page1 : Page&#10;{&#10;    private void Next_Click(object sender, RoutedEventArgs e)&#10;    {&#10;        NavigationService.Navigate(new Page2());&#10;    }&#10;}&#10;&#10;// UserControl - 재사용 컴포넌트&#10;public partial class MyControl : UserControl&#10;{&#10;    // 어떤 컨테이너에서든 사용 가능&#10;}"/>
                        </Expander>
                        <!-- 직접 해보기 3_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 페이지 안에 다음 화면으로 가는 버튼을 배치하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice3_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;StackPanel Margin=&quot;10&quot;&gt;&#10;    &lt;TextBlock Text=&quot;1 단계&quot; FontSize=&quot;16&quot;/&gt;&#10;    &#10;&lt;/StackPanel&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint3_2"
                                           Text="힌트: Button 에 Content 와 Width 를 지정합니다."
                                           Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder3_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel3_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Page 생명주기 -->
                        <GroupBox Header="Page 생명주기" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Page가 로드되고 언로드되는 과정:" Margin="0,0,0,10"/>
                                <Border Background="#FFFDE7" Padding="15" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="1. 생성자 호출 (new Page1())" FontFamily="Consolas"/>
                                        <TextBlock Text="   ↓" HorizontalAlignment="Center"/>
                                        <TextBlock Text="2. InitializeComponent()" FontFamily="Consolas"/>
                                        <TextBlock Text="   ↓" HorizontalAlignment="Center"/>
                                        <TextBlock Text="3. Loaded 이벤트" FontFamily="Consolas"/>
                                        <TextBlock Text="   ↓" HorizontalAlignment="Center"/>
                                        <TextBlock Text="4. OnNavigatedTo 호출" FontFamily="Consolas"/>
                                        <TextBlock Text="   ↓" HorizontalAlignment="Center"/>
                                        <TextBlock Text="5. 화면에 표시" FontFamily="Consolas" FontWeight="Bold"/>
                                        <TextBlock Text="   ↓" HorizontalAlignment="Center"/>
                                        <TextBlock Text="6. OnNavigatingFrom (떠나기 전)" FontFamily="Consolas"/>
                                        <TextBlock Text="   ↓" HorizontalAlignment="Center"/>
                                        <TextBlock Text="7. OnNavigatedFrom (떠난 후)" FontFamily="Consolas"/>
                                    </StackPanel>
