<Window x:Class="ch24_컨텍스트메뉴.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch24_컨텍스트메뉴"
        mc:Ignorable="d"
        Title="ch24 ContextMenu 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="420"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl>
            <!-- 탭 1: 기본 사용법 -->
            <TabItem Header="기본 사용법">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="ContextMenu 기본 사용법" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- 기본 ContextMenu -->
                        <GroupBox Header="기본 ContextMenu" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="마우스 우클릭으로 ContextMenu를 표시합니다:" Margin="0,0,0,5"/>
                                <Border Background="LightBlue" Padding="20" CornerRadius="5">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="항목 1"/>
                                            <MenuItem Header="항목 2"/>
                                            <MenuItem Header="항목 3"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="이 영역에서 마우스 우클릭하세요" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Border Background=&quot;LightBlue&quot; Padding=&quot;20&quot;&gt;&#10;    &lt;Border.ContextMenu&gt;&#10;        &lt;ContextMenu&gt;&#10;            &lt;MenuItem Header=&quot;항목 1&quot;/&gt;&#10;            &lt;MenuItem Header=&quot;항목 2&quot;/&gt;&#10;            &lt;MenuItem Header=&quot;항목 3&quot;/&gt;&#10;        &lt;/ContextMenu&gt;&#10;    &lt;/Border.ContextMenu&gt;&#10;    &lt;TextBlock Text=&quot;이 영역에서 마우스 우클릭하세요&quot;/&gt;&#10;&lt;/Border&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: Button 에 &quot;복사&quot;, &quot;붙여넣기&quot; 두 항목을 가진 ContextMenu 를 붙이세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Button Content=&quot;마우스 오른쪽 클릭&quot; Padding=&quot;20,10&quot;&gt;&#10;    &#10;&lt;/Button&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_1"
                                           Text="힌트: &lt;Button.ContextMenu&gt; 안에 &lt;ContextMenu&gt; 를 넣고 MenuItem 을 나열합니다."
                                           Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- TextBlock에 ContextMenu -->
                        <GroupBox Header="TextBlock에 ContextMenu" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="TextBlock에 ContextMenu를 연결합니다:" Margin="0,0,0,5"/>
                                <TextBlock x:Name="contextTextBlock" Text="이 텍스트를 우클릭하세요"
                                           FontSize="16" Padding="10" Background="LightYellow">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="복사"/>
                                            <MenuItem Header="잘라내기"/>
                                            <MenuItem Header="붙여넣기"/>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;TextBlock Text=&quot;이 텍스트를 우클릭하세요&quot; FontSize=&quot;16&quot;&gt;&#10;    &lt;TextBlock.ContextMenu&gt;&#10;        &lt;ContextMenu&gt;&#10;            &lt;MenuItem Header=&quot;복사&quot;/&gt;&#10;            &lt;MenuItem Header=&quot;잘라내기&quot;/&gt;&#10;            &lt;MenuItem Header=&quot;붙여넣기&quot;/&gt;&#10;        &lt;/ContextMenu&gt;&#10;    &lt;/TextBlock.ContextMenu&gt;&#10;&lt;/TextBlock&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: TextBox 에 &quot;잘라내기&quot;와 &quot;삭제&quot; 항목을 가진 ContextMenu 를 붙이세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;TextBox Text=&quot;여기서 오른쪽 클릭&quot; Width=&quot;200&quot;&gt;&#10;    &#10;&lt;/TextBox&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_2"
                                           Text="힌트: TextBox.ContextMenu 를 지정하면 기본 메뉴를 대체합니다."
                                           Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Button에 ContextMenu -->
                        <GroupBox Header="Button에 ContextMenu" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="Button에 ContextMenu를 연결합니다:" Margin="0,0,0,5"/>
                                <Button Content="이 버튼을 우클릭하세요" Padding="20,10" HorizontalAlignment="Left">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="실행"/>
                                            <MenuItem Header="설정"/>
                                            <Separator/>
                                            <MenuItem Header="도움말"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;Button Content=&quot;이 버튼을 우클릭하세요&quot; Padding=&quot;20,10&quot;&gt;&#10;    &lt;Button.ContextMenu&gt;&#10;        &lt;ContextMenu&gt;&#10;            &lt;MenuItem Header=&quot;실행&quot;/&gt;&#10;            &lt;MenuItem Header=&quot;설정&quot;/&gt;&#10;            &lt;Separator/&gt;&#10;            &lt;MenuItem Header=&quot;도움말&quot;/&gt;&#10;        &lt;/ContextMenu&gt;&#10;    &lt;/Button.ContextMenu&gt;&#10;&lt;/Button&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 1_3 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: TextBlock 에 &quot;새로 고침&quot; 항목 하나짜리 ContextMenu 를 붙이세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_3"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;TextBlock Text=&quot;오른쪽 클릭&quot; Padding=&quot;30&quot; Background=&quot;#EEEEEE&quot;&gt;&#10;    &#10;&lt;/TextBlock&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_3"
                                           Text="힌트: &lt;TextBlock.ContextMenu&gt; 안에 ContextMenu 를 넣습니다."
                                           Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel1_3"/>
                                </Border>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Click 이벤트 -->
                        <GroupBox Header="Click 이벤트 처리" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="MenuItem의 Click 이벤트로 동작을 처리합니다:" Margin="0,0,0,5"/>
                                <Border Background="LightGreen" Padding="20" CornerRadius="5">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="메시지 표시" Click="ShowMessage_Click"/>
                                            <MenuItem Header="시간 표시" Click="ShowTime_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="우클릭하여 메뉴 선택" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;MenuItem Header=&quot;메시지 표시&quot; Click=&quot;ShowMessage_Click&quot;/&gt;&#10;&#10;// C# 코드&#10;private void ShowMessage_Click(object sender, RoutedEventArgs e)&#10;{&#10;    MessageBox.Show(&quot;메뉴 항목이 클릭되었습니다!&quot;, &quot;알림&quot;);&#10;}"/>
                        </Expander>
                        <!-- 직접 해보기 1_4 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: 컨텍스트 메뉴 항목을 누르면 알림 상자를 띄우는 핸들러를 완성하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice1_4"
                                         Style="{StaticResource PracticeInputStyle}"
                                         AcceptsReturn="True"
                                         Text="private void ShowMessage_Click(object sender, RoutedEventArgs e)&#10;{&#10;    &#10;}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="1_4"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_4"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_4"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint1_4"
                                           Text="힌트: MessageBox.Show(&quot;본문&quot;, &quot;제목&quot;) 형태로 호출합니다."
                                           Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtResult1_4" Margin="0,8,0,0" FontWeight="Bold"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                    

</StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 2: 계층 구조와 스타일 -->
            <TabItem Header="계층 구조와 스타일">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="계층 구조와 스타일" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- 서브메뉴 -->
                        <GroupBox Header="서브메뉴 (중첩 MenuItem)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="MenuItem을 중첩하여 서브메뉴를 만듭니다:" Margin="0,0,0,5"/>
                                <Border Background="LightCoral" Padding="20" CornerRadius="5">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="파일">
                                                <MenuItem Header="새로 만들기"/>
                                                <MenuItem Header="열기"/>
                                                <MenuItem Header="저장"/>
                                            </MenuItem>
                                            <MenuItem Header="편집">
                                                <MenuItem Header="잘라내기"/>
                                                <MenuItem Header="복사"/>
                                                <MenuItem Header="붙여넣기"/>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="우클릭하여 서브메뉴 확인" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;ContextMenu&gt;&#10;    &lt;MenuItem Header=&quot;파일&quot;&gt;&#10;        &lt;MenuItem Header=&quot;새로 만들기&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;열기&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;저장&quot;/&gt;&#10;    &lt;/MenuItem&gt;&#10;    &lt;MenuItem Header=&quot;편집&quot;&gt;&#10;        &lt;MenuItem Header=&quot;잘라내기&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;복사&quot;/&gt;&#10;        &lt;MenuItem Header=&quot;붙여넣기&quot;/&gt;&#10;    &lt;/MenuItem&gt;&#10;&lt;/ContextMenu&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 2_1 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: ContextMenu 안에 &quot;정렬&quot; 항목을 만들고 그 아래 &quot;이름순&quot;, &quot;날짜순&quot;을 넣으세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_1"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Border Background=&quot;#EEEEEE&quot; Padding=&quot;30&quot;&gt;&#10;    &lt;TextBlock Text=&quot;오른쪽 클릭&quot;/&gt;&#10;    &#10;&lt;/Border&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_1"
                                           Text="힌트: Border.ContextMenu 에 ContextMenu 를 넣고, MenuItem 을 중첩합니다."
                                           Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_1"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 아이콘과 단축키 -->
                        <GroupBox Header="아이콘과 InputGestureText" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="아이콘과 단축키 표시를 추가합니다:" Margin="0,0,0,5"/>
                                <Border Background="LightSteelBlue" Padding="20" CornerRadius="5">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="새로 만들기" InputGestureText="Ctrl+N">
                                                <MenuItem.Icon>
                                                    <Rectangle Width="14" Height="14" Fill="LightBlue" Stroke="DarkBlue"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="열기" InputGestureText="Ctrl+O">
                                                <MenuItem.Icon>
                                                    <Ellipse Width="14" Height="14" Fill="Yellow" Stroke="Orange"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="저장" InputGestureText="Ctrl+S">
                                                <MenuItem.Icon>
                                                    <Polygon Points="7,0 14,14 0,14" Fill="Green"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="우클릭하여 아이콘/단축키 확인" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <Expander Style="{StaticResource CodeExpanderStyle}">
                            <TextBox Style="{StaticResource CodeTextBoxStyle}" Text="&lt;MenuItem Header=&quot;새로 만들기&quot; InputGestureText=&quot;Ctrl+N&quot;&gt;&#10;    &lt;MenuItem.Icon&gt;&#10;        &lt;Rectangle Width=&quot;14&quot; Height=&quot;14&quot; Fill=&quot;LightBlue&quot; Stroke=&quot;DarkBlue&quot;/&gt;&#10;    &lt;/MenuItem.Icon&gt;&#10;&lt;/MenuItem&gt;&#10;&lt;MenuItem Header=&quot;열기&quot; InputGestureText=&quot;Ctrl+O&quot;&gt;&#10;    &lt;MenuItem.Icon&gt;&#10;        &lt;Ellipse Width=&quot;14&quot; Height=&quot;14&quot; Fill=&quot;Yellow&quot; Stroke=&quot;Orange&quot;/&gt;&#10;    &lt;/MenuItem.Icon&gt;&#10;&lt;/MenuItem&gt;"/>
                        </Expander>
                        <!-- 직접 해보기 2_2 -->
                        <Expander Style="{StaticResource PracticeExpanderStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="과제: ContextMenu 의 배경을 연노랑(#FFFDE7)으로 바꾸고 항목 하나를 굵게 표시하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtPractice2_2"
                                         Style="{StaticResource PracticeInputStyle}"
                                         Text="&lt;Button Content=&quot;오른쪽 클릭&quot; Padding=&quot;20,10&quot;&gt;&#10;    &lt;Button.ContextMenu&gt;&#10;        &lt;ContextMenu&gt;&#10;            &#10;        &lt;/ContextMenu&gt;&#10;    &lt;/Button.ContextMenu&gt;&#10;&lt;/Button&gt;"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                    <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                    <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                                </StackPanel>
                                <TextBlock x:Name="txtHint2_2"
                                           Text="힌트: ContextMenu 에 Background, MenuItem 에 FontWeight=&quot;Bold&quot; 를 지정합니다."
                                           Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                    <StackPanel x:Name="resultPanel2_2"/>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- IsCheckable -->
                        <GroupBox Header="IsCheckable (체크 가능 메뉴)" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="IsCheckable로 토글 가능한 메뉴를 만듭니다:" Margin="0,0,0,5"/>
                                <TextBlock x:Name="checkableText" Text="이 텍스트를 우클릭하세요"
                                           FontSize="16" Padding="10" Background="LightPink">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="굵게" IsCheckable="True" Checked="Bold_Checked" Unchecked="Bold_Unchecked"/>
                                            <MenuItem Header="기울임" IsCheckable="True" Checked="Italic_Checked" Unchecked="Italic_Unchecked"/>
