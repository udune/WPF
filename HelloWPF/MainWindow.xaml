<Window x:Class="HelloWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HelloWPF"
        mc:Ignorable="d"
        Title="WPF 학습 현황판" Height="720" Width="1000">

    <Window.Resources>
        <Style x:Key="HeadCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 요약 -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WPF 학습 현황판" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtSummary" Text="불러오는 중..." Foreground="#BBBBBB"
                               FontSize="13" Margin="0,6,0,0"/>
                    <ProgressBar x:Name="barOverall" Height="8" Margin="0,10,0,0"
                                 Minimum="0" Maximum="100" Foreground="#4CAF50" Background="#3F3F46"
                                 BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="btnRefresh" Content="새로고침" Click="BtnRefresh_Click"
                            Padding="14,7" Background="#0E639C" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="btnOpenFolder" Content="기록 폴더 열기" Click="BtnOpenFolder_Click"
                            Padding="14,7" Margin="8,0,0,0" Background="#3F3F46" Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 안내 -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="16,10"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock x:Name="txtFooter" Foreground="#666666" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- 챕터 목록 -->
        <ListView x:Name="lstChapters" BorderThickness="0" Margin="0"
                  MouseDoubleClick="LstChapters_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="챕터" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Padding="0,4"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="진도" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Height="16" Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 Foreground="{Binding BarBrush}" Background="#EEEEEE"
                                                 BorderBrush="#DDDDDD"/>
                                    <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="연습" Width="110"
                                    DisplayMemberBinding="{Binding PracticeText}"/>
                    <GridViewColumn Header="시도" Width="70"
                                    DisplayMemberBinding="{Binding Runs}"/>
                    <GridViewColumn Header="실행 횟수" Width="80"
                                    DisplayMemberBinding="{Binding LaunchCount}"/>
                    <GridViewColumn Header="학습 시간" Width="90"
                                    DisplayMemberBinding="{Binding StudyTimeText}"/>
                    <GridViewColumn Header="최근 학습" Width="120"
                                    DisplayMemberBinding="{Binding LastStudiedText}"/>

                    <GridViewColumn Header="" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="실행" Tag="{Binding}" Click="BtnLaunch_Click"
                                        Padding="10,3" IsEnabled="{Binding CanLaunch}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
