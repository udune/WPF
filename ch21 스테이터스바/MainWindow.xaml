<Window x:Class="ch21_스테이터스바.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch21_스테이터스바"
        mc:Ignorable="d"
        Title="ch21 StatusBar 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <!-- 코드 보기 스타일 -->
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="420"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <TabControl>
        <!-- 탭 1: 기본 사용법 -->
        <TabItem Header="기본 사용법">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="StatusBar 기본 사용법" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="StatusBar는 창 하단에 상태 정보를 표시하는 컨트롤입니다. StatusBarItem을 사용하여 여러 항목을 배치할 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <!-- 예제 1: 기본 StatusBar -->
                    <GroupBox Header="기본 StatusBar" Margin="0,0,0,15">
                        <StackPanel>
                            <Border BorderBrush="Gray" BorderThickness="1" Height="150">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Top" Text="(메인 콘텐츠 영역)"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="Gray" Margin="0,50,0,0"/>
                                    <StatusBar DockPanel.Dock="Bottom">
                                        <StatusBarItem Content="준비"/>
                                    </StatusBar>
                                </DockPanel>
                            </Border>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;DockPanel LastChildFill=&quot;False&quot;&gt;&#10;    &lt;!-- 메인 콘텐츠 --&gt;&#10;    &lt;StatusBar DockPanel.Dock=&quot;Bottom&quot;&gt;&#10;        &lt;StatusBarItem Content=&quot;준비&quot;/&gt;&#10;    &lt;/StatusBar&gt;&#10;&lt;/DockPanel&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 1_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: StatusBar를 만들고 StatusBarItem에 '상태: 준비됨' 텍스트를 표시하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_1"
                                       Text="힌트: StatusBarItem의 Content 속성에 텍스트를 설정합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: 여러 항목 -->
                    <GroupBox Header="여러 StatusBarItem" Margin="0,0,0,15">
                        <StackPanel>
                            <StatusBar Height="25">
                                <StatusBarItem Content="항목 1"/>
                                <StatusBarItem Content="항목 2"/>
                                <StatusBarItem Content="항목 3"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar&gt;&#10;    &lt;StatusBarItem Content=&quot;항목 1&quot;/&gt;&#10;    &lt;StatusBarItem Content=&quot;항목 2&quot;/&gt;&#10;    &lt;StatusBarItem Content=&quot;항목 3&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 1_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: Separator를 사용해서 '파일명' | '100%' | '저장됨' 세 항목을 구분하여 표시하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_2"
                                       Text="힌트: StatusBarItem 사이에 &lt;Separator/&gt; 태그를 배치합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: Separator 사용 -->
                    <GroupBox Header="Separator로 구분" Margin="0,0,0,15">
                        <StackPanel>
                            <StatusBar Height="25">
                                <StatusBarItem Content="파일"/>
                                <Separator/>
                                <StatusBarItem Content="줄: 42"/>
                                <Separator/>
                                <StatusBarItem Content="열: 15"/>
                                <Separator/>
                                <StatusBarItem Content="UTF-8"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar&gt;&#10;    &lt;StatusBarItem Content=&quot;파일&quot;/&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;StatusBarItem Content=&quot;줄: 42&quot;/&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;StatusBarItem Content=&quot;열: 15&quot;/&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;StatusBarItem Content=&quot;UTF-8&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 1_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: StatusBar 에 항목 2개를 넣고 사이를 Separator 로 나누세요. 왼쪽은 파일명, 오른쪽은 인코딩입니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_3"
                                       Text="힌트: StatusBarItem 사이에 &lt;Separator/&gt; 를 넣습니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                
</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭 2: 레이아웃 -->
        <TabItem Header="레이아웃">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="StatusBar 레이아웃" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- 예제 1: ItemsPanel 변경 -->
                    <GroupBox Header="Grid로 레이아웃 (ItemsPanel)" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="StatusBar의 ItemsPanel을 Grid로 변경하면 정확한 너비 조절이 가능합니다."
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StatusBar Height="25">
                                <StatusBar.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </ItemsPanelTemplate>
                                </StatusBar.ItemsPanel>
                                <StatusBarItem Content="메시지 영역 (자동 확장)" Grid.Column="0"/>
                                <Separator Grid.Column="1"/>
                                <StatusBarItem Content="고정 100px" Grid.Column="2"/>
                                <Separator Grid.Column="3"/>
                                <StatusBarItem Content="고정 100px" Grid.Column="4"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar&gt;&#10;    &lt;StatusBar.ItemsPanel&gt;&#10;        &lt;ItemsPanelTemplate&gt;&#10;            &lt;Grid&gt;&#10;                &lt;Grid.ColumnDefinitions&gt;&#10;                    &lt;ColumnDefinition Width=&quot;*&quot;/&gt;&#10;                    &lt;ColumnDefinition Width=&quot;Auto&quot;/&gt;&#10;                    &lt;ColumnDefinition Width=&quot;100&quot;/&gt;&#10;                &lt;/Grid.ColumnDefinitions&gt;&#10;            &lt;/Grid&gt;&#10;        &lt;/ItemsPanelTemplate&gt;&#10;    &lt;/StatusBar.ItemsPanel&gt;&#10;    &lt;StatusBarItem Content=&quot;메시지&quot; Grid.Column=&quot;0&quot;/&gt;&#10;    &lt;Separator Grid.Column=&quot;1&quot;/&gt;&#10;    &lt;StatusBarItem Content=&quot;고정&quot; Grid.Column=&quot;2&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 2_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: DockPanel ItemsPanel을 사용하여 '좌측' 항목은 왼쪽에, '우측' 항목은 오른쪽에 고정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &lt;StatusBar.ItemsPanel&gt;&#10;        &lt;ItemsPanelTemplate&gt;&#10;            &lt;DockPanel/&gt;&#10;        &lt;/ItemsPanelTemplate&gt;&#10;    &lt;/StatusBar.ItemsPanel&gt;&#10;    &#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_1"
                                       Text="힌트: DockPanel.Dock=&quot;Left&quot; 또는 &quot;Right&quot;를 사용합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: DockPanel 레이아웃 -->
                    <GroupBox Header="DockPanel로 레이아웃" Margin="0,0,0,15">
                        <StackPanel>
                            <StatusBar Height="25">
                                <StatusBar.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <DockPanel LastChildFill="True"/>
                                    </ItemsPanelTemplate>
                                </StatusBar.ItemsPanel>
                                <StatusBarItem Content="왼쪽 고정" DockPanel.Dock="Left"/>
                                <Separator DockPanel.Dock="Left"/>
                                <StatusBarItem Content="오른쪽 고정" DockPanel.Dock="Right"/>
                                <Separator DockPanel.Dock="Right"/>
                                <StatusBarItem Content="중앙 (나머지 공간 채움)" HorizontalContentAlignment="Center"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar&gt;&#10;    &lt;StatusBar.ItemsPanel&gt;&#10;        &lt;ItemsPanelTemplate&gt;&#10;            &lt;DockPanel LastChildFill=&quot;True&quot;/&gt;&#10;        &lt;/ItemsPanelTemplate&gt;&#10;    &lt;/StatusBar.ItemsPanel&gt;&#10;    &lt;StatusBarItem Content=&quot;왼쪽&quot; DockPanel.Dock=&quot;Left&quot;/&gt;&#10;    &lt;Separator DockPanel.Dock=&quot;Left&quot;/&gt;&#10;    &lt;StatusBarItem Content=&quot;오른쪽&quot; DockPanel.Dock=&quot;Right&quot;/&gt;&#10;    &lt;StatusBarItem Content=&quot;중앙&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 2_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: StatusBar의 Height를 30으로 설정하고, StatusBarItem에 Padding='15,5'를 적용하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &lt;StatusBarItem Content=&quot;패딩 적용&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_2"
                                       Text="힌트: StatusBar에 Height=&quot;30&quot;, StatusBarItem에 Padding=&quot;15,5&quot; 속성을 추가합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: 높이와 패딩 -->
                    <GroupBox Header="높이와 패딩" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Height=20" Margin="0,0,0,3"/>
                            <StatusBar Height="20" Margin="0,0,0,10">
                                <StatusBarItem Content="작은 상태바"/>
                            </StatusBar>

                            <TextBlock Text="Height=35, Padding 적용" Margin="0,0,0,3"/>
                            <StatusBar Height="35">
                                <StatusBarItem Content="큰 상태바" Padding="10,0"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar Height=&quot;20&quot;&gt;&#10;    &lt;StatusBarItem Content=&quot;작은 상태바&quot;/&gt;&#10;&lt;/StatusBar&gt;&#10;&#10;&lt;StatusBar Height=&quot;35&quot;&gt;&#10;    &lt;StatusBarItem Content=&quot;큰 상태바&quot; Padding=&quot;10,0&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 2_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: StatusBar 의 높이를 28 로 고정하고 배경을 연한 파랑으로 바꾸세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &lt;StatusBarItem Content=&quot;준비&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_3"
                                       Text="힌트: Height 와 Background 를 StatusBar 에 지정합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                
</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭 3: 다양한 콘텐츠 -->
        <TabItem Header="다양한 콘텐츠">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <TextBlock Text="StatusBar에 다양한 콘텐츠 배치" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- 예제 1: ProgressBar -->
                    <GroupBox Header="ProgressBar 포함" Margin="0,0,0,15">
                        <StackPanel>
                            <StatusBar Height="25">
                                <StatusBarItem Content="다운로드 중..."/>
                                <StatusBarItem>
                                    <ProgressBar Width="150" Height="15" Value="65"/>
                                </StatusBarItem>
                                <StatusBarItem Content="65%"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar&gt;&#10;    &lt;StatusBarItem Content=&quot;다운로드 중...&quot;/&gt;&#10;    &lt;StatusBarItem&gt;&#10;        &lt;ProgressBar Width=&quot;150&quot; Height=&quot;15&quot; Value=&quot;65&quot;/&gt;&#10;    &lt;/StatusBarItem&gt;&#10;    &lt;StatusBarItem Content=&quot;65%&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 3_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: StatusBar에 ProgressBar(Width=100, Height=15, Value=50)와 '50%' 텍스트를 표시하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice3_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &lt;StatusBarItem&gt;&#10;        &#10;    &lt;/StatusBarItem&gt;&#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="3_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="3_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="3_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint3_1"
                                       Text="힌트: StatusBarItem 안에 ProgressBar를 배치하고, 또 다른 StatusBarItem에 Content='50%'를 설정합니다."
