                                    <TextBox AcceptsReturn="True" AcceptsTab="True"
                                             Text="텍스트를 입력하세요..." VerticalScrollBarVisibility="Auto"/>
                                </DockPanel>
                            </Border>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;DockPanel&gt;&#10;    &lt;StatusBar DockPanel.Dock=&quot;Bottom&quot;&gt;&#10;        &lt;StatusBar.ItemsPanel&gt;&#10;            &lt;ItemsPanelTemplate&gt;&#10;                &lt;Grid&gt;...&lt;/Grid&gt;&#10;            &lt;/ItemsPanelTemplate&gt;&#10;        &lt;/StatusBar.ItemsPanel&gt;&#10;        &lt;StatusBarItem Content=&quot;준비&quot; Grid.Column=&quot;0&quot;/&gt;&#10;        &lt;Separator Grid.Column=&quot;1&quot;/&gt;&#10;        &lt;StatusBarItem Content=&quot;줄: 1&quot; Grid.Column=&quot;2&quot;/&gt;&#10;        ...&#10;    &lt;/StatusBar&gt;&#10;    &lt;TextBox AcceptsReturn=&quot;True&quot;/&gt;&#10;&lt;/DockPanel&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 5_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 파일 브라우저 스타일 StatusBar를 만드세요. '10개 파일' | '2개 선택' | '500 KB' 형식으로 Separator로 구분합니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_1"
                                       Text="힌트: StatusBarItem 세 개를 만들고, 각각 사이에 &lt;Separator/&gt;를 배치합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: 파일 브라우저 스타일 -->
                    <GroupBox Header="파일 브라우저 스타일" Margin="0,0,0,15">
                        <StackPanel>
                            <StatusBar Height="25">
                                <StatusBarItem Content="25개 항목"/>
                                <Separator/>
                                <StatusBarItem Content="3개 선택됨"/>
                                <Separator/>
                                <StatusBarItem Content="총 크기: 1.5 MB"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar&gt;&#10;    &lt;StatusBarItem Content=&quot;25개 항목&quot;/&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;StatusBarItem Content=&quot;3개 선택됨&quot;/&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;StatusBarItem Content=&quot;총 크기: 1.5 MB&quot;/&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 5_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 어두운 배경(#333333)의 StatusBar에 파란색 Ellipse와 흰색 '동기화 중' 텍스트를 표시하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar Background=&quot;#333333&quot;&gt;&#10;    &lt;StatusBarItem&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;            &#10;        &lt;/StackPanel&gt;&#10;    &lt;/StatusBarItem&gt;&#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_2"
                                       Text="힌트: Ellipse에 Fill=&quot;Blue&quot;, TextBlock에 Foreground=&quot;White&quot;를 설정합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: 이미지 뷰어 스타일 -->
                    <GroupBox Header="이미지 뷰어 스타일" Margin="0,0,0,15">
                        <StackPanel>
                            <StatusBar Height="30">
                                <StatusBar.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <DockPanel LastChildFill="True"/>
                                    </ItemsPanelTemplate>
                                </StatusBar.ItemsPanel>
                                <StatusBarItem Content="image.jpg" DockPanel.Dock="Left"/>
                                <Separator DockPanel.Dock="Left"/>
                                <StatusBarItem Content="1920 x 1080" DockPanel.Dock="Left"/>
                                <Separator DockPanel.Dock="Left"/>
                                <StatusBarItem DockPanel.Dock="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="-" Width="25" Click="ZoomOut_Click"/>
                                        <TextBlock x:Name="imageZoomText" Text="100%" VerticalAlignment="Center" Margin="5,0"/>
                                        <Button Content="+" Width="25" Click="ZoomIn_Click"/>
                                    </StackPanel>
                                </StatusBarItem>
                                <Separator DockPanel.Dock="Right"/>
                                <StatusBarItem Content="2.4 MB" HorizontalContentAlignment="Center"/>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar&gt;&#10;    &lt;StatusBar.ItemsPanel&gt;&#10;        &lt;ItemsPanelTemplate&gt;&#10;            &lt;DockPanel LastChildFill=&quot;True&quot;/&gt;&#10;        &lt;/ItemsPanelTemplate&gt;&#10;    &lt;/StatusBar.ItemsPanel&gt;&#10;    &lt;StatusBarItem Content=&quot;image.jpg&quot; DockPanel.Dock=&quot;Left&quot;/&gt;&#10;    &lt;StatusBarItem DockPanel.Dock=&quot;Right&quot;&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;            &lt;Button Content=&quot;-&quot; Click=&quot;ZoomOut_Click&quot;/&gt;&#10;            &lt;TextBlock Text=&quot;100%&quot;/&gt;&#10;            &lt;Button Content=&quot;+&quot; Click=&quot;ZoomIn_Click&quot;/&gt;&#10;        &lt;/StackPanel&gt;&#10;    &lt;/StatusBarItem&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 5_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 편집기 하단 표시줄을 만드세요. 줄/열 정보, 구분선, 인코딩, 구분선, 저장 상태 순입니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar&gt;&#10;    &#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_3"
                                       Text="힌트: StatusBarItem 과 Separator 를 번갈아 배치합니다."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 4: 네트워크 모니터 스타일 -->
                    <GroupBox Header="네트워크 모니터 스타일" Margin="0,0,0,15">
                        <StackPanel>
                            <StatusBar Height="28" Background="#2D2D30">
                                <StatusBarItem>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="LimeGreen" Margin="0,0,5,0"/>
                                        <TextBlock Text="온라인" Foreground="White"/>
                                    </StackPanel>
                                </StatusBarItem>
                                <Separator/>
                                <StatusBarItem>
                                    <TextBlock Text="↓ 2.5 MB/s" Foreground="LightGreen"/>
                                </StatusBarItem>
                                <Separator/>
                                <StatusBarItem>
                                    <TextBlock Text="↑ 0.8 MB/s" Foreground="LightBlue"/>
                                </StatusBarItem>
                                <Separator/>
                                <StatusBarItem>
                                    <TextBlock Text="지연: 24ms" Foreground="White"/>
                                </StatusBarItem>
                            </StatusBar>
                            <Expander Style="{StaticResource CodeExpanderStyle}">
                                <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                         Text="&lt;StatusBar Background=&quot;#2D2D30&quot;&gt;&#10;    &lt;StatusBarItem&gt;&#10;        &lt;StackPanel Orientation=&quot;Horizontal&quot;&gt;&#10;            &lt;Ellipse Width=&quot;8&quot; Height=&quot;8&quot; Fill=&quot;LimeGreen&quot;/&gt;&#10;            &lt;TextBlock Text=&quot;온라인&quot; Foreground=&quot;White&quot;/&gt;&#10;        &lt;/StackPanel&gt;&#10;    &lt;/StatusBarItem&gt;&#10;    &lt;Separator/&gt;&#10;    &lt;StatusBarItem&gt;&#10;        &lt;TextBlock Text=&quot;↓ 2.5 MB/s&quot; Foreground=&quot;LightGreen&quot;/&gt;&#10;    &lt;/StatusBarItem&gt;&#10;&lt;/StatusBar&gt;"/>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <!-- 직접 해보기 5_4 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 어두운 배경의 StatusBar에 초록 점 + '온라인' 문구, 구분선, 전송 속도를 표시하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice5_4"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;StatusBar Background=&quot;#2D2D30&quot;&gt;&#10;    &#10;&lt;/StatusBar&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="5_4"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="5_4"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="5_4"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint5_4"
                                       Text="힌트: 점과 글자를 한 칸에 두려면 StatusBarItem 안에 가로 StackPanel 을 씁니다. 어두운 배경에는 Foreground 를 밝게 주세요."
                                       Foreground="#FF9800" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder5_4" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel5_4"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                
</StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
