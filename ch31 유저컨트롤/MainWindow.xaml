                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="// UserControl1.xaml.cs&#10;public partial class UserControl1 : UserControl&#10;{&#10;    // 커스텀 이벤트 정의&#10;    public event EventHandler&lt;string&gt; TextChanged;&#10;    public event EventHandler MaxLengthReached;&#10;&#10;    public UserControl1()&#10;    {&#10;        InitializeComponent();&#10;        DataContext = this;&#10;&#10;        // 내부 TextBox의 이벤트 연결&#10;        txt.TextChanged += Txt_TextChanged;&#10;    }&#10;&#10;    private void Txt_TextChanged(object sender, TextChangedEventArgs e)&#10;    {&#10;        // 외부로 이벤트 발생&#10;        TextChanged?.Invoke(this, txt.Text);&#10;&#10;        // 최대 글자 수 도달 시 이벤트&#10;        if (txt.Text.Length &gt;= txt.MaxLength)&#10;        {&#10;            MaxLengthReached?.Invoke(this, EventArgs.Empty);&#10;        }&#10;    }&#10;}&#10;&#10;// MainWindow에서 이벤트 구독&#10;uc1.TextChanged += (s, text) =&gt;&#10;{&#10;    Console.WriteLine($&quot;텍스트 변경: {text}&quot;);&#10;};&#10;&#10;uc1.MaxLengthReached += (s, e) =&gt;&#10;{&#10;    MessageBox.Show(&quot;최대 글자 수에 도달했습니다!&quot;);&#10;};"/>
