<Window x:Class="ch31_유저컨트롤.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ch31_유저컨트롤"
        xmlns:uc="clr-namespace:ch31_유저컨트롤.uc"
        mc:Ignorable="d"
        Title="ch31 유저컨트롤 튜토리얼" Height="600" Width="850">

    <Window.Resources>
        <!-- 코드 보기 Expander 스타일 -->
        <Style x:Key="CodeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="코드 보기"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <!-- 코드 표시 TextBox 스타일 -->
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="420"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 직접 해보기 스타일 -->
        <Style x:Key="PracticeExpanderStyle" TargetType="Expander">
            <Setter Property="Header" Value="직접 해보기"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <Style x:Key="PracticeInputStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="420"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="HintButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <TabControl>
        <!-- 탭 1: 기본 사용법 -->
        <TabItem Header="기본 사용법">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="UserControl 기본 사용법" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="UserControl은 재사용 가능한 사용자 정의 컨트롤입니다. 여러 컨트롤을 하나로 묶어 재사용할 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- 예제 1: 기본 UserControl 사용 -->
                    <GroupBox Header="1. 기본 UserControl 사용" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="UserControl을 XAML에서 선언하고 속성을 설정합니다:" Margin="0,0,0,10"/>
                            <uc:UserControl1 Title="기본 예제" MaxLength="50" PbHeight="15"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 1. xmlns에 UserControl 네임스페이스 등록 --&gt;&#10;xmlns:uc=&quot;clr-namespace:ch31_유저컨트롤.uc&quot;&#10;&#10;&lt;!-- 2. UserControl 사용 --&gt;&#10;&lt;uc:UserControl1 Title=&quot;기본 예제&quot; MaxLength=&quot;50&quot; PbHeight=&quot;15&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: UserControl 안에 들어갈 내용을 만들어 보세요. 테두리 있는 Border 안에 제목 TextBlock 을 넣습니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Border BorderBrush=&quot;#999999&quot; BorderThickness=&quot;1&quot; Padding=&quot;10&quot;&gt;&#10;    &#10;&lt;/Border&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_1"
                                       Text="힌트: UserControl 의 내용도 결국 일반 레이아웃과 같습니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_1" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_1"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: 여러 UserControl 인스턴스 -->
                    <GroupBox Header="2. 여러 UserControl 인스턴스" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="하나의 UserControl을 여러 번 재사용할 수 있습니다:" Margin="0,0,0,10"/>
                            <uc:UserControl1 Title="이름 입력" MaxLength="20" PbHeight="10" Margin="0,0,0,5"/>
                            <uc:UserControl1 Title="이메일 입력" MaxLength="50" PbHeight="10" Margin="0,0,0,5"/>
                            <uc:UserControl1 Title="주소 입력" MaxLength="100" PbHeight="10"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 같은 UserControl을 다른 속성으로 여러 번 사용 --&gt;&#10;&lt;uc:UserControl1 Title=&quot;이름 입력&quot; MaxLength=&quot;20&quot; PbHeight=&quot;10&quot;/&gt;&#10;&lt;uc:UserControl1 Title=&quot;이메일 입력&quot; MaxLength=&quot;50&quot; PbHeight=&quot;10&quot;/&gt;&#10;&lt;uc:UserControl1 Title=&quot;주소 입력&quot; MaxLength=&quot;100&quot; PbHeight=&quot;10&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 1_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 코드에서 사용자 컨트롤을 만들어 패널(host)에 추가하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="private void Add_Click(object sender, RoutedEventArgs e)&#10;{&#10;    &#10;}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="1_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_2"
                                       Text="힌트: new 로 컨트롤을 만든 뒤 host.Children.Add 로 붙입니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult1_2" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: UserControl 구조 설명 -->
                    <GroupBox Header="3. UserControl 파일 구조" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run FontWeight="Bold">UserControl 프로젝트 구조:</Run>
                            </TextBlock>
                            <TextBlock FontFamily="Consolas" Margin="10,0,0,0">
                                📁 uc/&#x0a;
                                    ├── UserControl1.xaml (UI 정의)&#x0a;
                                    └── UserControl1.xaml.cs (코드 비하인드)
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="// UserControl1.xaml.cs - 기본 구조&#10;namespace ch31_유저컨트롤.uc&#10;{&#10;    public partial class UserControl1 : UserControl&#10;    {&#10;        // 외부에서 설정 가능한 속성&#10;        public string Title { get; set; }&#10;        public string MaxLength { get; set; }&#10;        public string PbHeight { get; set; }&#10;&#10;        public UserControl1()&#10;        {&#10;            InitializeComponent();&#10;            DataContext = this;  // 바인딩을 위해 필수&#10;        }&#10;    }&#10;}"/>
                    </Expander>
                    <!-- 직접 해보기 1_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 제목 줄과 본문이 나뉜 패널 모양을 만드세요. 사용자 컨트롤의 기본 골격입니다." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice1_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;Border BorderBrush=&quot;#90A4AE&quot; BorderThickness=&quot;1&quot; Width=&quot;240&quot;&gt;&#10;    &#10;&lt;/Border&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="1_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="1_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="1_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint1_3"
                                       Text="힌트: DockPanel 로 제목을 위에 고정하고 본문을 아래에 둡니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder1_3" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel1_3"/>
                            </Border>
                        </StackPanel>
                    </Expander>
                                    

</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭 2: 속성과 바인딩 -->
        <TabItem Header="속성과 바인딩">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="UserControl 속성과 바인딩" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="UserControl은 속성을 정의하고 DataContext를 통해 바인딩할 수 있습니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- 예제 1: DataContext 바인딩 -->
                    <GroupBox Header="1. DataContext 바인딩" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="UserControl 생성자에서 DataContext = this로 설정하면 속성에 바인딩할 수 있습니다:"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#F5F5F5" Padding="10" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="속성 바인딩 흐름:" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                                        외부 XAML: Title="제목"&#x0a;
                                        → UserControl1.Title = "제목"&#x0a;
                                        → DataContext.Title&#x0a;
                                        → {Binding Title} → Label.Content
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="// UserControl1.xaml.cs&#10;public partial class UserControl1 : UserControl&#10;{&#10;    public string Title { get; set; }&#10;&#10;    public UserControl1()&#10;    {&#10;        InitializeComponent();&#10;        DataContext = this;  // 중요! 이게 없으면 바인딩 안 됨&#10;    }&#10;}&#10;&#10;&lt;!-- UserControl1.xaml --&gt;&#10;&lt;Label Content=&quot;{Binding Title}&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_1 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 사용자 컨트롤에 바인딩 가능한 Title 의존 속성을 선언하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_1"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="public static readonly DependencyProperty TitleProperty =&#10;    &#10;&#10;public string Title&#10;{&#10;    get { return (string)GetValue(TitleProperty); }&#10;    set { SetValue(TitleProperty, value); }&#10;}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="2_1"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_1"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_1"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_1"
                                       Text="힌트: DependencyProperty.Register(&quot;Title&quot;, typeof(string), typeof(MyControl)) 형태입니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult2_1" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 2: ElementName 바인딩 -->
                    <GroupBox Header="2. ElementName 바인딩" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="UserControl 내부에서 다른 요소의 속성을 바인딩할 수 있습니다:"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <uc:UserControl1 Title="ElementName 바인딩 예제" MaxLength="30" PbHeight="20"/>
                            <TextBlock Text="↑ TextBox의 Text.Length가 ProgressBar.Value와 글자 수 표시에 바인딩됩니다."
                                       FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- UserControl1.xaml 내부 --&gt;&#10;&#10;&lt;!-- TextBox에 Name 지정 --&gt;&#10;&lt;TextBox Name=&quot;txt&quot; MaxLength=&quot;{Binding MaxLength}&quot;/&gt;&#10;&#10;&lt;!-- ElementName으로 txt 참조 --&gt;&#10;&lt;TextBlock Text=&quot;{Binding ElementName=txt, Path=Text.Length}&quot;/&gt;&#10;&#10;&lt;!-- ProgressBar도 txt에 바인딩 --&gt;&#10;&lt;ProgressBar Value=&quot;{Binding ElementName=txt, Path=Text.Length, Mode=OneWay}&quot;&#10;             Maximum=&quot;{Binding MaxLength}&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_2 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 컨트롤 내부에서 자기 자신의 Title 속성을 표시하도록 RelativeSource 바인딩을 하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_2"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="&lt;TextBlock Text=&quot;{Binding }&quot; FontWeight=&quot;Bold&quot;/&gt;"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="실행" Style="{StaticResource RunButtonStyle}" Click="BtnRun_Click" Tag="2_2"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_2"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_2"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_2"
                                       Text="힌트: RelativeSource={RelativeSource AncestorType=UserControl} 을 씁니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <Border x:Name="resultBorder2_2" Background="White" Margin="0,8,0,0" Padding="10" Visibility="Collapsed">
                                <StackPanel x:Name="resultPanel2_2"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 예제 3: 바인딩 모드 -->
                    <GroupBox Header="3. 바인딩 모드" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="WPF 바인딩 모드 종류:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="OneWay" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>
                                <TextBlock Text="소스 → 대상 (읽기 전용)" Grid.Row="0" Grid.Column="1"/>
                                <TextBlock Text="TwoWay" FontWeight="Bold" Grid.Row="1" Grid.Column="0"/>
                                <TextBlock Text="소스 ↔ 대상 (양방향)" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Text="OneTime" FontWeight="Bold" Grid.Row="2" Grid.Column="0"/>
                                <TextBlock Text="처음 한 번만 바인딩" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Text="OneWayToSource" FontWeight="Bold" Grid.Row="3" Grid.Column="0"/>
                                <TextBlock Text="대상 → 소스" Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <Expander Style="{StaticResource CodeExpanderStyle}">
                        <TextBox Style="{StaticResource CodeTextBoxStyle}"
                                 Text="&lt;!-- 바인딩 모드 예제 --&gt;&#10;&#10;&lt;!-- OneWay: 기본값 (Label, TextBlock 등) --&gt;&#10;&lt;TextBlock Text=&quot;{Binding Name, Mode=OneWay}&quot;/&gt;&#10;&#10;&lt;!-- TwoWay: TextBox 등 입력 컨트롤 기본값 --&gt;&#10;&lt;TextBox Text=&quot;{Binding Name, Mode=TwoWay}&quot;/&gt;&#10;&#10;&lt;!-- OneTime: 초기값만 필요할 때 --&gt;&#10;&lt;Label Content=&quot;{Binding Title, Mode=OneTime}&quot;/&gt;&#10;&#10;&lt;!-- ProgressBar는 OneWay가 적절 --&gt;&#10;&lt;ProgressBar Value=&quot;{Binding Progress, Mode=OneWay}&quot;/&gt;"/>
                    </Expander>
                    <!-- 직접 해보기 2_3 -->
                    <Expander Style="{StaticResource PracticeExpanderStyle}">
                        <StackPanel Margin="10">
                            <TextBlock Text="과제: 의존 속성에 기본값을 지정하세요." FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="txtPractice2_3"
                                     Style="{StaticResource PracticeInputStyle}"
                                     Text="public static readonly DependencyProperty TitleProperty =&#10;    DependencyProperty.Register(&quot;Title&quot;, typeof(string), typeof(MyControl));"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="확인" Style="{StaticResource RunButtonStyle}" Click="BtnCheck_Click" Tag="2_3"/>
                                <Button Content="힌트" Style="{StaticResource HintButtonStyle}" Click="BtnHint_Click" Tag="2_3"/>
                                <Button Content="정답 보기" Style="{StaticResource AnswerButtonStyle}" Click="BtnAnswer_Click" Tag="2_3"/>
                            </StackPanel>
                            <TextBlock x:Name="txtHint2_3"
                                       Text="힌트: Register 의 네 번째 인자로 new PropertyMetadata(기본값) 을 넘깁니다."
                                       Foreground="#2196F3" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtResult2_3" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                                    

</StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 탭 3: 레이아웃과 구성 -->
        <TabItem Header="레이아웃과 구성">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="UserControl 레이아웃과 구성" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="UserControl 내부 레이아웃을 구성하는 방법을 알아봅니다."
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- 예제 1: Grid 레이아웃 -->
                    <GroupBox Header="1. Grid 레이아웃" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
